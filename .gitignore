# Dependencies
node_modules/

# Build output (hosts rebuild this from source)
continent-app/dist/
continent-app/.vercel/
# The local review tool runs from the dev server; a build is only ever local
tools/trailslab/review/dist/

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# Environment / secrets
.env
.env.*
# ...except the template, which holds no values and is the only place the
# required env vars are documented (the READMEs point readers at it).
!.env.example
cache/otm_key.txt

# OS
.DS_Store
Thumbs.db
# Git Bash crash dumps
*.stackdump

# Stray Git LFS hooks accidentally written to a literal `dev/null/` path
# (a misfired `/dev/null` redirect); they belong in .git/hooks, not the repo.
dev/

# Runtime logs + harvester stderr dumps
logs/
*.log
*.err

# Dev screenshots taken at the app root (Playwright verify runs etc.);
# real image assets live in continent-app/public/ and stay tracked.
continent-app/*.png

# Inside Airbnb raw downloads (harvest_accommodation.py re-fetches them)
cache/iab/
cache/worldclim/

# Pipeline orchestrator: timestamped master backups + run state/lock
app_data/backups/
logs/pipeline_state.json
logs/pipeline.lock

# Large local pipeline master + backups - NOT committed, to stay off the Git LFS
# quota treadmill (a ~50 MB file committed often would exhaust the 1 GB LFS quota
# in ~20 revisions). The app runs from the committed continent-app/public/*.json
# payload; sync-data.mjs falls back to that when the master is absent. Rebuild the
# master locally from the tracked scripts + caches (run_pipeline.py).
app_data/app_data.json
app_data/app_data.backup.json
app_data/*.pre_*.json

# Beach layer harvest caches (pipeline/beaches): 159 MB and rewritten whole on
# every refresh, which is the same treadmill as the master above. Note that the
# LFS rule a few lines up is `cache/*.json`, which does NOT match a
# subdirectory, so these would land as ordinary blobs in an already 3 GB .git.
# They are derived data: the app serves continent-app/public/beaches, and the
# caches only save a cold rebuild (hours of polite Overpass). Rebuild with
# python pipeline/beaches/build_beaches.py
cache/beaches/

# Mountain layer harvest caches (pipeline/mountains): 17 MB of raw and rich
# per country snapshots, rewritten whole on every refresh. Same call as
# cache/beaches above and for the same reasons: it is derived data, the app
# serves continent-app/public/mountains, and the .git here is already 3 GB.
# A cold rebuild is
#   python pipeline/mountains/build_peaks.py
# and the Wikidata spine it reads (cache/features_wikidata.json) is the part
# that would actually be slow to re-fetch.
cache/mountains/

# Lake layer harvest caches (pipeline/lakes): 29 MB, same call again. These
# did briefly get committed, by a `git add -A` that swept the whole working
# tree, so this rule comes with a `git rm --cached` rather than on its own.
# The blobs already in history stay there; what this stops is the next one.
cache/lakes/

# Trail layer caches (pipeline/trails, tools/trailslab): 135 MB of per-trip
# photo and geometry snapshots, rewritten whole on every refresh. Same call as
# the three above, and the same reason the .git here is already 3 GB. The app
# serves continent-app/public/trails; these only save a cold rebuild.
cache/trails/

# Trip layer caches (pipeline/trips): the composed candidate set and the
# Wikivoyage route harvest, both rewritten whole on every refresh. Same call
# as the three above: derived data, the app serves continent-app/public/trips,
# and a cold rebuild is
#   python pipeline/trips/harvest_routes.py   (a few minutes of Wikimedia)
#   python pipeline/trips/compose_trips.py && python pipeline/trips/export_trips.py
# The harvest is the only slow part, and it is resumable.
cache/trips/

# Headless verification screenshots (regenerated by scripts/verify_*.mjs)
continent-app/scripts/shots/
continent-app/shots/
tools/trailslab/review/scripts/shots/

# Raw ingestion mirrors (src/ingestion): re-downloadable, often tens of GB.
# data/staging holds manually exported restricted files (EUROCONTROL DDR).
data/raw/
data/staging/

# Fare estimation layer (src/estimation): weekly fare snapshot history,
# trained model artifacts + estimate exports, schema-gate quarantine.
data/history/
data/models/
data/deadletter/

# Travelpayouts staging (contract B): ~19 MB regenerated by every weekly
# collector run; committing it would be the same LFS quota treadmill as the
# master. The merge (harvest_all_origins.py tp) tolerates its absence, and
# the merged result ships in continent-app/public/fares/ anyway.
data/derived/tp_fares.json

# Coverage candidate universe (docs/COVERAGE.md): ~70 MB of every plausible
# European destination with its measurements, rebuilt offline in ~75 seconds
# by build_place_candidates.py from the gazetteer and the POI corpus, both of
# which ARE tracked. The scored output that people actually read is small and
# committed: data/reports/coverage/ and coverage_gaps.json.
data/derived/place_candidates.json
