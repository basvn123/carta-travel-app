# Dependencies
node_modules/

# Build output (hosts rebuild this from source)
continent-app/dist/
continent-app/.vercel/
# The local review tool runs from the dev server; a build is only ever local
tools/trailslab/review/dist/

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# Environment / secrets
.env
.env.*
# ...except the template, which holds no values and is the only place the
# required env vars are documented (the READMEs point readers at it).
!.env.example
cache/otm_key.txt

# OS
.DS_Store
Thumbs.db
# Git Bash crash dumps
*.stackdump

# Stray Git LFS hooks accidentally written to a literal `dev/null/` path
# (a misfired `/dev/null` redirect); they belong in .git/hooks, not the repo.
dev/

# Runtime logs + harvester stderr dumps
logs/
*.log
*.err

# Dev screenshots taken at the app root (Playwright verify runs etc.);
# real image assets live in continent-app/public/ and stay tracked.
continent-app/*.png

# Inside Airbnb raw downloads (harvest_accommodation.py re-fetches them)
cache/iab/
cache/worldclim/

# Pipeline orchestrator: timestamped master backups + run state/lock
app_data/backups/
logs/pipeline_state.json
logs/pipeline.lock

# Large local pipeline master + backups - NOT committed, to stay off the Git LFS
# quota treadmill (a ~50 MB file committed often would exhaust the 1 GB LFS quota
# in ~20 revisions). The app runs from the committed continent-app/public/*.json
# payload; sync-data.mjs falls back to that when the master is absent. Rebuild the
# master locally from the tracked scripts + caches (run_pipeline.py).
app_data/app_data.json
app_data/app_data.backup.json
app_data/*.pre_*.json

# Headless verification screenshots (regenerated by scripts/verify_*.mjs)
continent-app/scripts/shots/
tools/trailslab/review/scripts/shots/

# Raw ingestion mirrors (src/ingestion): re-downloadable, often tens of GB.
# data/staging holds manually exported restricted files (EUROCONTROL DDR).
data/raw/
data/staging/

# Fare estimation layer (src/estimation): weekly fare snapshot history,
# trained model artifacts + estimate exports, schema-gate quarantine.
data/history/
data/models/
data/deadletter/

# Travelpayouts staging (contract B): ~19 MB regenerated by every weekly
# collector run; committing it would be the same LFS quota treadmill as the
# master. The merge (harvest_all_origins.py tp) tolerates its absence, and
# the merged result ships in continent-app/public/fares/ anyway.
data/derived/tp_fares.json
