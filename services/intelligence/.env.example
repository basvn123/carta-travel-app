# Copy to services/intelligence/.env on the box (never commit .env).
# One entry per caller: id:sha256-of-key[:requests-per-minute]. Make a key with
#   python -c "from intelligence.auth import new_key; k, h = new_key(); print(k); print(h)"
# Give the caller the key; put only the hash here.
INTEL_API_KEYS=pipeline:REPLACE_WITH_SHA256_HEX:6000
INTEL_RATE_PER_MIN=120
INTEL_BURST=30
INTEL_BRIDGE_TIMEOUT_S=10
# INTEL_TAGS_PATH=/app/cache/taxonomy/tags.json   (default: tags.json, else tags-sample.json)
