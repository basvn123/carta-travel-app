{
 "version": 1,
 "about": "Contract cases for POST /profile (T1154, ROADMAP F5): the F3 taste profile rules (HANDBOOK 'Taste profile with validation', continent-app/src/lib/taste/profile.js) on the real catalogue. Written in the T1154 session from those rules, not labelled by travellers: they pin behaviour, they do not measure taste. Each case is a request body and what the answer must hold.",
 "now": "2026-11-06T12:00:00Z",
 "cases": [
  {"id": "p01", "rule": "three saved beach places make a beach chip with its evidence",
   "request": {"saves": [{"key": "dest:NCE", "kind": "dest", "id": "NCE"}, {"key": "dest:FAO", "kind": "dest", "id": "FAO"}, {"key": "dest:SPU", "kind": "dest", "id": "SPU"}]},
   "expect": {"shown_has": ["set.beach"], "evidence": {"set.beach": {"saves": 3, "trips": 0, "filters": 0}}, "item_count": 3}},
  {"id": "p02", "rule": "one saved place is below the bar (at least three items)",
   "request": {"saves": [{"key": "dest:NCE", "kind": "dest", "id": "NCE"}]},
   "expect": {"shown_count": 0, "item_count": 1}},
  {"id": "p03", "rule": "nothing given, nothing shown",
   "request": {},
   "expect": {"shown_count": 0, "item_count": 0}},
  {"id": "p04", "rule": "a rejected chip is hidden, listed under hidden, and a negative weight of -3",
   "request": {"saves": [{"key": "dest:NCE", "kind": "dest", "id": "NCE"}, {"key": "dest:FAO", "kind": "dest", "id": "FAO"}, {"key": "dest:SPU", "kind": "dest", "id": "SPU"}], "verdicts": {"set.beach": {"v": "reject"}}},
   "expect": {"shown_lacks": ["set.beach"], "hidden_has": ["set.beach"], "weights": {"set.beach": -3}}},
  {"id": "p05", "rule": "an accepted chip comes first with its verdict and a weight of +1",
   "request": {"saves": [{"key": "dest:GVA", "kind": "dest", "id": "GVA"}, {"key": "dest:ZRH", "kind": "dest", "id": "ZRH"}, {"key": "dest:KLU", "kind": "dest", "id": "KLU"}, {"key": "dest:NCE", "kind": "dest", "id": "NCE"}, {"key": "dest:FAO", "kind": "dest", "id": "FAO"}, {"key": "dest:SPU", "kind": "dest", "id": "SPU"}], "verdicts": {"set.lake": {"v": "accept"}}},
   "expect": {"first": "set.lake", "first_verdict": "accept", "weights": {"set.lake": 1}}},
  {"id": "p06", "rule": "a rejection taken back with no evidence left still shows under hidden, so it can be undone",
   "request": {"verdicts": {"set.beach": {"v": "reject"}}},
   "expect": {"shown_count": 0, "hidden_has": ["set.beach"]}},
  {"id": "p07", "rule": "a trip weighs 3: a trip and one save clear the bar (two items when one is a trip), the trip named first",
   "request": {"trips": [{"id": "t1", "name": "Lakes week", "at": "2026-11-05T12:00:00Z", "destIds": ["GVA"]}], "saves": [{"key": "dest:KLU", "kind": "dest", "id": "KLU"}]},
   "expect": {"shown_has": ["set.lake"], "evidence": {"set.lake": {"trips": 1, "saves": 1}}, "first_name": {"set.lake": "Lakes week"}}},
  {"id": "p08", "rule": "old items fade: four year old saves no longer make a chip (half life 180 days)",
   "request": {"saves": [{"key": "dest:NCE", "kind": "dest", "id": "NCE", "at": "2022-11-06T12:00:00Z"}, {"key": "dest:FAO", "kind": "dest", "id": "FAO", "at": "2022-11-06T12:00:00Z"}, {"key": "dest:SPU", "kind": "dest", "id": "SPU", "at": "2022-11-06T12:00:00Z"}]},
   "expect": {"shown_lacks": ["set.beach"]}},
  {"id": "p09", "rule": "filters count as evidence at half a save: filters alone stay under the bar of 2",
   "request": {"filters": {"likes": ["beach", "city", "culture"]}},
   "expect": {"shown_count": 0, "item_count": 3}},
  {"id": "p10", "rule": "at most six chips and two per facet first; twelve when opened",
   "request": {"saves": [{"key": "dest:GVA", "kind": "dest", "id": "GVA"}, {"key": "dest:ZRH", "kind": "dest", "id": "ZRH"}, {"key": "dest:KLU", "kind": "dest", "id": "KLU"}, {"key": "dest:NCE", "kind": "dest", "id": "NCE"}, {"key": "dest:FAO", "kind": "dest", "id": "FAO"}, {"key": "dest:SPU", "kind": "dest", "id": "SPU"}, {"key": "dest:BOD", "kind": "dest", "id": "BOD"}, {"key": "dest:OPO", "kind": "dest", "id": "OPO"}, {"key": "dest:VLL", "kind": "dest", "id": "VLL"}, {"key": "dest:INN", "kind": "dest", "id": "INN"}, {"key": "dest:FLR", "kind": "dest", "id": "FLR"}, {"key": "dest:PRG", "kind": "dest", "id": "PRG"}, {"key": "dest:VIE", "kind": "dest", "id": "VIE"}]},
   "expect": {"shown_max": 6}},
  {"id": "p11", "rule": "the same request opened shows up to twelve",
   "request": {"all": true, "saves": [{"key": "dest:GVA", "kind": "dest", "id": "GVA"}, {"key": "dest:ZRH", "kind": "dest", "id": "ZRH"}, {"key": "dest:KLU", "kind": "dest", "id": "KLU"}, {"key": "dest:NCE", "kind": "dest", "id": "NCE"}, {"key": "dest:FAO", "kind": "dest", "id": "FAO"}, {"key": "dest:SPU", "kind": "dest", "id": "SPU"}, {"key": "dest:BOD", "kind": "dest", "id": "BOD"}, {"key": "dest:OPO", "kind": "dest", "id": "OPO"}, {"key": "dest:VLL", "kind": "dest", "id": "VLL"}, {"key": "dest:INN", "kind": "dest", "id": "INN"}, {"key": "dest:FLR", "kind": "dest", "id": "FLR"}, {"key": "dest:PRG", "kind": "dest", "id": "PRG"}, {"key": "dest:VIE", "kind": "dest", "id": "VIE"}]},
   "expect": {"shown_max": 12, "shown_min_more_than": "p10"}},
  {"id": "p12", "rule": "the snapshot the account keeps names chips, facets and evidence counts only, no place names",
   "request": {"saves": [{"key": "dest:NCE", "kind": "dest", "id": "NCE"}, {"key": "dest:FAO", "kind": "dest", "id": "FAO"}, {"key": "dest:SPU", "kind": "dest", "id": "SPU"}]},
   "expect": {"snapshot_no_names": true}}
 ]
}
