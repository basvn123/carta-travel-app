# The trails lab on the build box (T1182). Append these lines to the box
# secrets file ~/.config/carta/env (mode 600); infra/hetzner/cax11/load-env.sh
# exports them to weekly.sh, run_pipeline.py and lab.sh. Names only in git:
# fill the values on the box. `bash tools/trailslab/box/lab.sh env` prints
# this block with a fresh random password.

# The switch. "box": the lab lives on this box, the run_pipeline.py trails_*
# tasks run here against it, and the trailslab_worker task stands down (it
# would restore a dump that misses this lab's reviews). Blank: as before.
CARTA_TRAILSLAB_HOME=

# Where pipeline/trails/db.py and the run_pipeline.py guards find the lab.
TRAILSLAB_HOST=127.0.0.1
TRAILSLAB_PORT=5433
TRAILSLAB_DB=trailslab
TRAILSLAB_USER=trailslab
# Not "trailslab": lab.sh check refuses the laptop default on the box. Used
# by the image only on the first start of an empty data directory.
TRAILSLAB_PASSWORD=

# A directory on the Hetzner Volume (mounted at /mnt/trailslab by fstab).
TRAILSLAB_DATA_DIR=/mnt/trailslab/pgdata

# Who the review app stamps on trip_reviews rows (default: the OS user).
TRAILSLAB_REVIEWER=

# Optional tuning (defaults in docker-compose.box.yml, sized for a 4 GB CAX11
# that also runs the weekly pipeline).
TRAILSLAB_MEM_LIMIT=
TRAILSLAB_SHARED_BUFFERS=
TRAILSLAB_WORK_MEM=
TRAILSLAB_MAINT_MEM=

# lab.sh check: free space the data directory needs before a restore (GB).
CARTA_TRAILSLAB_MIN_FREE_GB=

# Scratch for dumps on their way in or out: on the volume, the root disk is
# too small for a 5 GB dump.
CARTA_TRAILSLAB_DUMP_DIR=/mnt/trailslab/dump
