# carta-gravel: accepts grade1 to grade3 track, still refuses traffic.
#
# The same shape as carta-touring with one difference that matters: an
# unpaved surface is a mild preference away from, not a penalty, so a route
# through a forest on grade-2 track wins over the same distance on a B road.
# What it does NOT relax is traffic. A gravel rider is on a quieter bike, not
# a braver one.
#
# The ceiling is grade3 and smoothness=very_bad, which is exactly what
# validate_cycling.py's BIKE_ALLOWS lets a tour declared "gravel" contain.
# Keep the two in step: a profile that routes over grade-4 produces tours the
# gate then refuses, which is wasted work rather than a bug.

---context:global

assign turnInstructionMode    = 1
assign considerTurnRestrictions = true
assign processUnusedTags      = false
assign validForBikes          = 1

assign downhillcost           = 60
assign downhillcutoff         = 1.5
assign uphillcost             = 60
assign uphillcutoff           = 1.5
assign uphillbuffer           = 0
assign downhillbuffer         = 0

assign avoid_unsafe           = true
assign allow_steps            = false
assign allow_ferries          = true

---context:way

assign turncost = 90
assign initialcost = 0

assign is_ldcr =
  or route_bicycle_icn=yes
  or route_bicycle_ncn=yes
  or route_bicycle_rcn=yes route_bicycle_lcn=yes

# Beyond this is a mountain bike, and a gravel tour that contained it would
# be refused by the gate.
assign too_rough =
  or tracktype=grade4
  or tracktype=grade5
  or smoothness=horrible
  or smoothness=very_horrible
  or smoothness=impassable
  or surface=sand surface=mud

assign bike_denied =
  or bicycle=no
  or bicycle=private
  or access=no access=private

assign road_cost =
  switch highway=cycleway                      1.0
  switch or highway=path highway=footway       1.0
  switch highway=track                         1.0
  switch highway=bridleway                     1.1
  switch highway=living_street                 1.1
  switch highway=residential                   1.2
  switch highway=service                       1.3
  switch highway=unclassified                  1.3
  switch highway=tertiary                      1.7
  switch or highway=tertiary_link highway=secondary_link 2.0
  switch highway=secondary                     2.8
  switch or highway=primary highway=primary_link 6.0
  switch or highway=trunk highway=trunk_link   10000
  switch highway=motorway                      10000
  switch highway=                              10000
  2.0

# Unpaved is neutral here, and asphalt carries no bonus: the point of the
# profile is that the rider does not care, so nothing should push either way.
assign surface_cost =
  switch too_rough 10000
  switch smoothness=very_bad 1.4
  switch smoothness=bad 1.15
  1.0

assign route_bonus =
  switch is_ldcr 0.8 1.0

assign costfactor =
  switch bike_denied 10000
  multiply road_cost multiply surface_cost route_bonus

---context:node

assign initialcost =
  switch or barrier=gate or barrier=lift_gate barrier=cycle_barrier 30
  switch highway=traffic_signals 20
  switch barrier=bollard 5
  0
