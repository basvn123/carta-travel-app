# Carta orchestrator secrets. On the box this file lives at
# /home/carta/.config/carta/env, mode 600, owned by carta; carta-bootstrap
# copies this example there on first boot and never overwrites it after.
# Fill it over SSH (nano ~/.config/carta/env). Never commit a filled copy.
#
# load-env.sh exports every line and then unsets the ones left blank, so a
# blank value means "not configured" and the code falls back to its default
# or skips the collector, exactly as on the laptop without a .env entry.
#
# Names were collected from the code on 2026-09-27: every os.environ read in
# run_pipeline.py, pipeline/ and src/, plus the repo-root .env.example.
# Endpoint overrides (FLIXBUS_GTFS_URL, SNCF_ODS_BASE and the like) are left
# out; each collector's docstring documents its own, and none is a secret.
#
# ANTHROPIC_API_KEY is deliberately absent. CLAUDE.md forbids the Claude API,
# carta-bootstrap strips the anthropic SDK from the venv, and since T264 no
# script in the repository has a Claude provider.

# --- R2 through rclone (pipeline/archive/push.py, T045) -------------------
# From an R2 API token with Object Read and Write on bucket "carta" only.
# The endpoint is https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ENDPOINT=
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=

# --- App data to production (run_pipeline.sh step 9, T054-e, T262) -------
# The data host. Blank: the weekly build is same-origin and stays on this box.
# Set to https://data.carta-europetravel.com/data only AFTER the production
# cutover (T054-c): from then on every good run uploads its split build to R2
# (push-data.mjs phase 1, never --prune). Before the data host is in the CSP
# (T053-b) the split build refuses to run, which fails the run's ship.
VITE_DATA_BASE=

# --- Cloudflare account API (push.py --lifecycle, the T995 deploy) --------
# The deploy (CARTA_DEPLOY below) needs a token with Account, Cloudflare
# Pages, Edit on the account that holds the carta-app project; wrangler reads
# both lines. Lifecycle rules from this box would need R2 rights as well.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Archive and backups (T045) -------------------------------------------
# Where pack.py writes tarballs; keep it off the repo checkout.
CARTA_ARCHIVE_OUT=
# Where the weekly encrypted dumps are written before the push (default
# $CARTA_ARCHIVE_OUT/dumps). A trailslab dump is about 5 GB: on the box, the
# lab volume (/mnt/trailslab/dumps) keeps it off the 38 GB root disk.
CARTA_DUMP_DIR=
# gpg recipient for the encrypted database dumps (public key only on this box)
CARTA_BACKUP_KEY=
# Supabase session pooler connection string, for the weekly dump
SUPABASE_DB_URL=

# --- Hetzner Cloud (T047: the orchestrator creates and deletes the CAX41) -
# A separate read/write token from the one used to provision this box.
HCLOUD_TOKEN=
# Optional (T047-f): a separate R2 token the workers carry instead of the
# box's own, so a worker's credentials can be revoked on their own.
CARTA_WORKER_R2_ACCESS_KEY_ID=
CARTA_WORKER_R2_SECRET_ACCESS_KEY=

# --- The trailslab worker (T647, run_pipeline.py task trailslab_worker) ---
# 1 turns the task on; blank keeps it a logged skip. Set it only after a
# selftest spawn and one hand-started `spawn.sh trailslab worker-key LI` run.
CARTA_TRAILSLAB_WORKER=
# worker-key (blank = worker-key) or plain: how the trailslab dump is read and
# written. worker-key needs the two lines below; plain stores the dump
# unencrypted (it holds ODbL OSM data and the trip_reviews ledger).
CARTA_TRAILSLAB_DUMP_CRYPT=
# The worker's own gpg SECRET key, armored, mode 600 (blank = the default
# ~/.config/carta/trailslab-worker.sec.asc). Dumps are encrypted to it and to
# CARTA_BACKUP_KEY above, whose public half must be in this box's keyring.
CARTA_WORKER_GPG_KEY_FILE=
# Days between worker runs (blank = 28) and the dump age that triggers a
# server-side keepalive copy on the Mondays in between (blank = 21).
CARTA_TRAILSLAB_EVERY_DAYS=
CARTA_TRAILSLAB_KEEPALIVE_DAYS=

# --- The trails lab on this box (T1182, T1201) ------------------------------
# box: the lab lives on this box's Hetzner Volume, the trails_* tasks run
# here and the trailslab_worker task stands down; blank keeps the worker.
# The TRAILSLAB_* lines it needs (host, port, db, user, password, data dir,
# tuning, dump dir) are in tools/trailslab/box/lab.env.example; append them
# here with `bash tools/trailslab/box/lab.sh env`, which also makes the password.
CARTA_TRAILSLAB_HOME=
# Days after the last push that carta-trailslab-push.timer pushes the box lab
# to R2 again (blank = 21; R2 expires archive/db/ after 30, the timer is weekly).
CARTA_TRAILSLAB_PUSH_DAYS=

# --- The stays scrape (T1161, infra/hetzner/cax11/stays_scrape.sh) ---------
# 1 turns the nightly carta-stays-scrape.timer on (it works in March and
# September only); blank keeps it a logged skip. hostelworld (blank) on the
# box; booking or both only on a host with a residential address, which then
# also sets CARTA_STAYS_BOOKING_EGRESS=residential. The remote must be one this
# token may write (blank = r2:carta-stays-state/state).
CARTA_STAYS_SCRAPE=
CARTA_STAYS_SITES=
CARTA_STAYS_BOOKING_EGRESS=
CARTA_STAYS_MAX_HOURS=
CARTA_STAYS_REMOTE=
# The trailslab worker moves approved trips to published (T1161): 1 passes
# `promote` to the job; blank keeps --no-promote.
CARTA_TRAILSLAB_PROMOTE=

# --- The run itself (run_pipeline.sh) -------------------------------------
# T1161 (H10): the ML extras run_pipeline.sh installs. ask (blank = ask):
# model2vec in the venv, so the Ask Carta index builds here. all: also a
# second venv (CARTA_GUIDED_VENV, blank = ~/venv-guided, about 1 GB) with CPU
# torch and sentence-transformers, so guided search runs here. none: neither.
CARTA_BOX_ML=
CARTA_GUIDED_VENV=
# Cadence ceiling for a HAND run: weekly (blank = weekly), monthly, quarterly
# or all. Since T1107 the timers set CARTA_TIER (weekly, monthly, quarterly)
# in their units, which wins over this line, so leave it blank; the tier table
# is infra/hetzner/cron/schedule.py.
CARTA_MAX_CADENCE=
# T640: task keys that run when due ABOVE the ceiling (run_pipeline.py
# --also), comma separated. Since T1107 the quarterly timer runs every one of
# the tasks below in its own tier, so this can stay blank; set it only to pull
# a task into the Monday run, with the `after` tasks that follow them. Leaves
# every other monthly and quarterly task held back (the stays, food and flight
# tasks of price batch F0 in particular), which CARTA_MAX_CADENCE=all would
# not. The explore data fill (docs/owner/explore-data-runs.md):
# crowding,transit_lines,airports,sea_temp,climate_daily,beach_context,peak_context,lake_detail,dest_overlays,poi_fees,trails_fields,dossier
# Setting it also makes run_pipeline.sh pull (when missing) the cache classes
# those tasks read, beaches-cache, mountains-cache, regions-cache, lakes-json
# (the JSON members of lakes-cache only) and explore-overlays, and push
# beaches-cache, mountains-cache and explore-overlays after a good run.
CARTA_EXTRA_TASKS=
# T640: hours after which run_pipeline.py starts no further --also task (the
# rest stay due and run next week). Blank = 16 when CARTA_EXTRA_TASKS is set,
# so a first run stays inside the Healthchecks grace of one day; 0 = no limit.
CARTA_MAX_HOURS=
# build (blank = build), data or none: what run_pipeline.py ships at the end.
CARTA_SHIP=
# T995: 1 deploys the app shell to Cloudflare Pages after a run that
# published data, then prunes the data host. Only when the build's entry
# script matches the live site's, so the box never deploys other code than
# what is live (run_pipeline.sh step 10). Blank or 0: deploy by hand.
CARTA_DEPLOY=
# T994: blank or 1 brings the clone to the newest origin main before each
# timer run (weekly.sh); 0 keeps whatever checkout is there.
CARTA_AUTO_UPDATE=

# --- Flight sweep, late tier (T798, carta-late-sweep.service) -------------
# The flight-sweep Worker's INGEST_TOKEN secret (wrangler secret put).
CARTA_SWEEP_INGEST_TOKEN=
# 1 stops every Google Flights search here, as on the Worker (ROADMAP I16,
# T1213-d); set it before the first paid sale, then restart the unit.
LADDER_STOP_GOOGLE_FLIGHTS=

# --- Pipeline monitoring (run_pipeline.py) --------------------------------
# URL pinged once per run; an external monitor alerts when a ping is missing.
CARTA_HEARTBEAT_URL=
# One row per run in public.pipeline_runs for the admin panel (migration 041).
# The service role key bypasses RLS: it lives here and never in continent-app.
CARTA_SUPABASE_URL=
CARTA_SUPABASE_SERVICE_KEY=

# --- Stay tiers and POIs (pipeline/harvest_*) -----------------------------
LITEAPI_KEY=
HW_CONSUMER_KEY=
HW_CONSUMER_SECRET=
OPENTRIPMAP_KEY=

# --- Fares (src/ingestion travelpayouts collector) ------------------------
TRAVELPAYOUTS_TOKEN=

# --- Raw open-data collectors (src/ingestion; missing keys SKIP) ----------
MOBILITYDATA_AT_USER=
MOBILITYDATA_AT_PASSWORD=
BELGIUM_OPENDATA_KEY=
DELIJN_API_KEY=
TRAFIKLAB_GTFS_SWEDEN_KEY=
TRAFIKLAB_NETEX_SWEDEN_KEY=
TRAFIKLAB_GTFS_REGIONAL_KEY=
OTD_SWISS_TOKEN=
NDOV_USER=
NDOV_PASS=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_USER=
OPENSKY_PASS=
KAGGLE_API_TOKEN=
KAGGLE_USERNAME=
KAGGLE_KEY=
GITHUB_TOKEN=

# --- Research and descriptions --------------------------------------------
# pipeline/trails/describe.py --provider gemini; the only model the pipeline
# may call (CLAUDE.md, "Never use the Claude API").
GEMINI_API_KEY=
CARTA_SEARCH_PROVIDER=
CARTA_SEARCH_KEY=
CARTA_SEARCH_CX=

# --- Optional knobs (defaults are right for this box; blank = default) ----
INGEST_DATA_DIR=
INGEST_STAGING_DIR=
ESTIMATION_HISTORY_DIR=
ESTIMATION_MODELS_DIR=
HARVEST_WORKERS=
HARVEST_DELAY=
