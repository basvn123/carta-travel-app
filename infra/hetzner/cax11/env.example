# Carta orchestrator secrets. On the box this file lives at
# /home/carta/.config/carta/env, mode 600, owned by carta; carta-bootstrap
# copies this example there on first boot and never overwrites it after.
# Fill it over SSH (nano ~/.config/carta/env). Never commit a filled copy.
#
# load-env.sh exports every line and then unsets the ones left blank, so a
# blank value means "not configured" and the code falls back to its default
# or skips the collector, exactly as on the laptop without a .env entry.
#
# Names were collected from the code on 2026-09-27: every os.environ read in
# run_pipeline.py, pipeline/ and src/, plus the repo-root .env.example.
# Endpoint overrides (FLIXBUS_GTFS_URL, SNCF_ODS_BASE and the like) are left
# out; each collector's docstring documents its own, and none is a secret.
#
# ANTHROPIC_API_KEY is deliberately absent. CLAUDE.md forbids the Claude API,
# carta-bootstrap strips the anthropic SDK from the venv, and T041-g tracks
# removing the provider from the two scripts that still carry it.

# --- R2 through rclone (pipeline/archive/push.py, T045) -------------------
# From an R2 API token with Object Read and Write on bucket "carta" only.
# The endpoint is https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ENDPOINT=
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=

# --- App data to production (run_pipeline.sh step 9, T054-e, T262) -------
# The data host. Blank: the weekly build is same-origin and stays on this box.
# Set to https://data.carta-europetravel.com/data only AFTER the production
# cutover (T054-c): from then on every good run uploads its split build to R2
# (push-data.mjs phase 1, never --prune). Before the data host is in the CSP
# (T053-b) the split build refuses to run, which fails the run's ship.
VITE_DATA_BASE=

# --- Cloudflare account API (push.py --lifecycle, T044 provision.sh) ------
# Only needed on the box if lifecycle rules are managed from here.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Archive and backups (T045) -------------------------------------------
# Where pack.py writes tarballs; keep it off the repo checkout.
CARTA_ARCHIVE_OUT=
# gpg recipient for the encrypted database dumps (public key only on this box)
CARTA_BACKUP_KEY=
# Supabase session pooler connection string, for the weekly dump
SUPABASE_DB_URL=

# --- Hetzner Cloud (T047: the orchestrator creates and deletes the CAX41) -
# A separate read/write token from the one used to provision this box.
HCLOUD_TOKEN=

# --- The run itself (run_pipeline.sh) -------------------------------------
# Cadence ceiling: weekly (blank = weekly), monthly, quarterly or all. Raise
# it only for tasks verified on arm64 (T048-h); every run under a ceiling logs
# the due tasks it holds back.
CARTA_MAX_CADENCE=
# build (blank = build), data or none: what run_pipeline.py ships at the end.
CARTA_SHIP=

# --- Pipeline monitoring (run_pipeline.py) --------------------------------
# URL pinged once per run; an external monitor alerts when a ping is missing.
CARTA_HEARTBEAT_URL=
# One row per run in public.pipeline_runs for the admin panel (migration 041).
# The service role key bypasses RLS: it lives here and never in continent-app.
CARTA_SUPABASE_URL=
CARTA_SUPABASE_SERVICE_KEY=

# --- Stay tiers and POIs (pipeline/harvest_*) -----------------------------
LITEAPI_KEY=
HW_CONSUMER_KEY=
HW_CONSUMER_SECRET=
OPENTRIPMAP_KEY=

# --- Fares (src/ingestion travelpayouts collector) ------------------------
TRAVELPAYOUTS_TOKEN=

# --- Raw open-data collectors (src/ingestion; missing keys SKIP) ----------
MOBILITYDATA_AT_USER=
MOBILITYDATA_AT_PASSWORD=
BELGIUM_OPENDATA_KEY=
DELIJN_API_KEY=
TRAFIKLAB_GTFS_SWEDEN_KEY=
TRAFIKLAB_NETEX_SWEDEN_KEY=
TRAFIKLAB_GTFS_REGIONAL_KEY=
OTD_SWISS_TOKEN=
NDOV_USER=
NDOV_PASS=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_USER=
OPENSKY_PASS=
KAGGLE_API_TOKEN=
KAGGLE_USERNAME=
KAGGLE_KEY=
GITHUB_TOKEN=

# --- Research and descriptions --------------------------------------------
# pipeline/trails/describe.py --provider gemini; the only model the pipeline
# may call (CLAUDE.md, "Never use the Claude API").
GEMINI_API_KEY=
CARTA_SEARCH_PROVIDER=
CARTA_SEARCH_KEY=
CARTA_SEARCH_CX=

# --- Optional knobs (defaults are right for this box; blank = default) ----
INGEST_DATA_DIR=
INGEST_STAGING_DIR=
ESTIMATION_HISTORY_DIR=
ESTIMATION_MODELS_DIR=
HARVEST_WORKERS=
HARVEST_DELAY=
