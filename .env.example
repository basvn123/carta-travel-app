# Pipeline credentials. Copy to `.env` in this folder (the REPO ROOT) and fill
# in; `.env` is gitignored and loaded by the pipeline scripts (env_local.py).
# Do NOT put these in continent-app/.env: that file is Vite's, and secrets
# there risk being bundled into the browser app.

# LiteAPI (hotel stay tiers, harvest_hotels_liteapi.py).
# Free self-service key: liteapi.travel
LITEAPI_KEY=

# Hostelworld Partner API (hostel stay tiers, harvest_hostelworld.py).
# From the affiliate programme welcome pack: partners.hostelworld.com
HW_CONSUMER_KEY=
HW_CONSUMER_SECRET=
