# Pipeline credentials. Copy to `.env` in this folder (the REPO ROOT) and fill
# in; `.env` is gitignored and loaded by the pipeline scripts (env_local.py).
# Do NOT put these in continent-app/.env: that file is Vite's, and secrets
# there risk being bundled into the browser app.

# LiteAPI (hotel stay tiers, harvest_hotels_liteapi.py).
# Free self-service key: liteapi.travel
LITEAPI_KEY=

# Hostelworld Partner API (hostel stay tiers, harvest_hostelworld.py).
# From the affiliate programme welcome pack: partners.hostelworld.com
HW_CONSUMER_KEY=
HW_CONSUMER_SECRET=

# ---------------------------------------------------------------------------
# src/ingestion raw data collection framework (python -m src.ingestion.run_all)
# Everything below is optional: collectors missing their keys report SKIP with
# instructions instead of failing. Endpoint override vars (portals rotate
# their URLs) are documented in each collector's docstring.

# Framework knobs
#INGEST_DATA_DIR=            # default <repo>/data/raw
#INGEST_STAGING_DIR=         # default <repo>/data/staging
#INGEST_USER_AGENT=          # pin one UA instead of rotating
#INGEST_PROXY_LIST=          # comma separated http://user:pass@host:port
#INGEST_PROXY_PROVIDER_URL=  # endpoint returning one proxy per line
#INGEST_RATE_LIMIT_SECONDS=1.0
#INGEST_HTTP_RETRIES=5
#INGEST_RT_INTERVAL=120      # sncf_realtime seconds between cycles
#INGEST_RT_CYCLES=5          # 0 = poll forever

# Austria: free account at mobilitaetsverbuende.at (Mobility Data Austria)
MOBILITYDATA_AT_USER=
MOBILITYDATA_AT_PASSWORD=

# Belgium: unified opendata gateway (GTFS static+realtime for De Lijn, SNCB,
# STIB, TEC) - subscribe to the Standard product at
# api-management-opendata-production.developer.azure-api.net
BELGIUM_OPENDATA_KEY=
# De Lijn's own portal (data.delijn.be) - not used for GTFS (that's the
# unified gateway above); reserved for its NeTEx/BLTAC-format product
DELIJN_API_KEY=

# Sweden: free per product keys from trafiklab.se
TRAFIKLAB_GTFS_SWEDEN_KEY=
TRAFIKLAB_NETEX_SWEDEN_KEY=
TRAFIKLAB_GTFS_REGIONAL_KEY=

# Switzerland: free account token from opentransportdata.swiss
OTD_SWISS_TOKEN=

# Netherlands NDOV account (basic auth for data.ndovloket.nl NeTEx folders)
NDOV_USER=
NDOV_PASS=

# Account scoped feed URLs for portals that bind downloads to a login
#MOBILITHEK_URLS=
#DENMARK_FEED_URLS=
#FINLAND_FEED_URLS=
#ERA_EXPORT_URLS=

# OpenSky Network: OAuth2 client from your opensky-network.org account
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Kaggle (Renfe pricing archives): new unified token (KGAT_..., from
# kaggle.com Settings > API), or the legacy pair, or ~/.kaggle/kaggle.json
KAGGLE_API_TOKEN=
KAGGLE_USERNAME=
KAGGLE_KEY=

# GitHub token, optional, raises search rate limits for ryanair_archive
GITHUB_TOKEN=

# Ferryhopper widget sampling (commercial source, keep it gentle)
#FERRYHOPPER_PAIRS=PIR-MYK,PIR-JTR,PIR-HER
#FERRYHOPPER_API_TMPL=

# Holiday calendars (events group; keyless). Override the country list or how
# many future years to fetch; endpoints rotate rarely but can be pinned too.
#HOLIDAY_COUNTRIES=BE,NL,FR,DE
#HOLIDAY_YEARS_AHEAD=1
#NAGER_API=https://date.nager.at/api/v3
#OPENHOLIDAYS_API=https://openholidaysapi.org

# ---------------------------------------------------------------------------
# src/estimation fare model (python -m src.estimation.{snapshot,model,drift})
# No credentials needed; optional relocation of the artifact dirs.
#ESTIMATION_HISTORY_DIR=     # default <repo>/data/history/fares
#ESTIMATION_MODELS_DIR=      # default <repo>/data/models
