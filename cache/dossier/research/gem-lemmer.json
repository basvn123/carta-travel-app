{"id": "gem:lemmer", "generated_at": "2026-08-26T21:26:45Z", "method": "web_sweep_v1", "n_usable_sources": 16, "of": 11, "do": [{"name": "Woudagemaal", "type": "activity", "detail": "The largest steam driven pumping station still working anywhere in the world, opened in 1920 and still started when Friesland needs the water off. World Heritage listed, with a visitor centre and a guided tour in the ticket.", "evidence": {"n_sources": 8, "of": 11, "urls": ["https://www.tripadvisor.com/Attractions-g1045111-Activities-Lemmer_Friesland_Province.html", "https://www.friesland.nl/en/routes/1173308402/iconic-water-features-sailing-route", "https://www.visitingthedutchcountryside.com/friesland/things-to-do-lemmer-friesland-netherlands/"]}}, {"name": "Sail the IJsselmeer", "type": "activity", "detail": "Lemmer sits on the gate between the Frisian lakes and the old Zuiderzee, so the round of the IJsselmeer starts here. The open crossing wants a decent yacht, not a sloop.", "season": [4, 5, 6, 7, 8, 9, 10], "evidence": {"n_sources": 7, "of": 11, "urls": ["https://www.friesland.nl/en/plan/see-do/to-do/routes/all-routes/3564397914/round-ijsselmeer-sailing-route", "https://www.naupar.com/blog/route-suggestion-ijsselmeer-frisian-coast/", "https://www.leboat.com/boating-vacations/netherlands/holland/friesland-travel-guide"]}}, {"name": "Lemsterstrand", "type": "swim", "detail": "Three and a half hectares of sand on the lake side just south west of town, looking into the bay. No sailing or surfing off the beach itself in summer.", "season": [6, 7, 8, 9], "evidence": {"n_sources": 5, "of": 11, "urls": ["https://www.livetheworld.com/activities/netherlands/lemmer-beach", "https://www.waterlandvanfriesland.nl/en/lemmer", "https://www.visitingthedutchcountryside.com/friesland/things-to-do-lemmer-friesland-netherlands/"]}}, {"name": "Walk around the Dock", "type": "activity", "detail": "The streets ringing the old harbour in the middle of town. The channel through Lemmer is the busy link between the Frisian lakes and the IJsselmeer, so the two bridges open and shut all day and the whole town watches the boats go through.", "evidence": {"n_sources": 5, "of": 11, "urls": ["https://www.waterlandvanfriesland.nl/en/lemmer", "https://www.visitingthedutchcountryside.com/friesland/things-to-do-lemmer-friesland-netherlands/", "https://www.tripadvisor.com/Attractions-g1045111-Activities-Lemmer_Friesland_Province.html"]}}, {"name": "Cycle into Gaasterland", "type": "activity", "detail": "South west of town the flat gives way to woods, low cliffs and lake shore. A bicycle ferry over the Rijnsloot gets you across, and the routes run on to Balk and Woudsend.", "season": [4, 5, 6, 7, 8, 9, 10], "evidence": {"n_sources": 5, "of": 11, "urls": ["https://www.friesland.nl/nl/routes/3755413076/fietsroute-zuidwest-friesland", "https://www.waterlandvanfriesland.nl/nl/routes/91014931/rondje-woudsend-lemmer-en-balk", "https://www.hartvanlemmer.nl/nieuws/fietsroutes-verhuur-en-oplaadpunten-e-bikes-in-lemmer/"]}}, {"name": "Out on the LE50", "type": "experience", "detail": "A Lemster fishing boat that worked until 1974 takes passengers onto the IJsselmeer on Friday afternoons from April to the middle of October.", "season": [4, 5, 6, 7, 8, 9, 10], "evidence": {"n_sources": 3, "of": 11, "urls": ["https://www.waterlandvanfriesland.nl/en/lemmer", "https://www.tripadvisor.com/Attractions-g1045111-Activities-Lemmer_Friesland_Province.html", "https://www.visitingthedutchcountryside.com/friesland/things-to-do-lemmer-friesland-netherlands/"]}}], "sources": ["https://www.friesland.nl/en/plan/see-do/to-do/routes/all-routes/3564397914/round-ijsselmeer-sailing-route", "https://www.friesland.nl/en/routes/1173308402/iconic-water-features-sailing-route", "https://www.friesland.nl/nl/routes/3755413076/fietsroute-zuidwest-friesland", "https://www.friesland.nl/nl/routes/91014931/rondje-woudsend-lemmer-en-balk", "https://www.friesnieuws.nl/ook-lemmer-krijgt-toeristisch-overstap-punt-watersportcent