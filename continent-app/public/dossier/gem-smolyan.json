:"Smolyan","url":"https://en.wikivoyage.org/wiki/Smolyan","licence":"CC BY-SA 4.0"}],"short":"Smolyan is a town in the Rhodope Mountains of Bulgaria. Rhodope Mountains, Golyam Perelik (peak) and Uhlovitsa Cave lead its 12 sights. Half a day covers it, ideally in May to September.","short_src":"composed","facts":{"population":30689,"visit_h":4.4}},"highlights":[{"id":"hl-rhodope-mountains","name":"Rhodope Mountains","kind":"Peak","lat":41.60111,"lon":24.57417,"dist_km":11.8,"rank_score":10.94,"resolved_by":"catalogue","image":{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/4/48/Rhodopen_Balkan_topo_de.jpg/500px-Rhodopen_Balkan_topo_de.jpg","author":"RosarioVanTulpe","licence":"CC BY-SA 3.0","licence_url":"http://creativecommons.org/licenses/by-sa/3.0/","page":"https://commons.wikimedia.org/wiki/File:Rhodopen_Balkan_topo_de.jpg","w":676,"h":542,"ok_print":true}},{"id":"hl-golyam-perelik-peak","name":"Golyam Perelik (peak)","kind":"Peak","lat":41.60111,"lon":24.57417,"dist_km":11.8,"rank_score":7.43,"resolved_by":"catalogue"},{"id":"hl-uhlovitsa-cave","name":"Uhlovitsa Cave","kind":"Cave","lat":41.51416,"lon":24.66006,"dist_km":8.0,"rank_score":7.22,"resolved_by":"catalogue","image":{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/d/dc/Uhlovitsa1.jpg/960px-Uhlovitsa1.jpg","author":"Kiril Kapustin","licence":"CC BY 2.5","licence_url":"https://creativecommons.org/licenses/by/2.5","page":"https://commons.wikimedia.org/wiki/File:Uhlovitsa1.jpg","w":1280,"h":939,"ok_print":true},"wikipedia":"https://en.wikipedia.org/wiki/Uhlovitsa","merged_from":["Uhlovitsa"]},{"id":"hl-cathedral-of-saint-vissarion-of-smolyan","name":"Cathedral of Saint Vissarion of Smolyan","kind":"Cathedral","lat":41.57523,"lon":24.70844,"dist_km":0.3,"sig":1.306,"rank_score":3.9,"resolved_by":"catalogue","fact":"Church in Smolyan, Bulgaria","image":{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/6/6d/St-Visarion-Smolenski-Church.jpg/960px-St-Visarion-Smolenski-Church