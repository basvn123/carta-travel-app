at/","https://touristear.com/en/best-things-to-do-sarlat-la-caneda-dordogne-perigord/","https://www.bontraveler.com/sarlat-la-caneda-france/"],"method":"web"},"sources":["web"]},{"name":"Winter truffle market and truffle festival","type":"festival","detail":"From December the Saturday market gains a black truffle stall row, and a dedicated truffle weekend lands in January.","season":[12,1,2],"evidence":{"n_sources":5,"of":11,"urls":["https://en.sarlat-tourisme.com/","https://www.frenchmoments.eu/sarlat-la-caneda/","https://lifeinruralfrance.com/things-to-do-in-sarlat/","https://touristear.com/en/best-things-to-do-sarlat-la-caneda-dordogne-perigord/","https://travelfrancebucketlist.com/things-to-do-in-sarlat-france/"],"method":"web"},"sources":["web"]},{"name":"Glass lift up the Sainte-Marie bell tower","type":"experience","detail":"A panoramic lift rises inside the deconsecrated church tower for a guided look over the stone roofs, running spring to December.","season":[4,5,6,7,8,9,10,11,12],"evidence":{"n_sources":5,"of":11,"urls":["https://en.wikivoyage.org/wiki/Sarlat-la-Can%C3%A9da","https://www.francethisway.com/places/sarlat.php","https://travelfrancebucketlist.com/things-to-do-in-sarlat-france/","https://avagabondlife.com/the-top-10-things-to-do-in-sarlat/","https://lifeinruralfrance.com/things-to-do-in-sarlat/"],"method":"web"},"sources":["web"]},{"name":"Canoe the Dordogne past the castle cliffs","type":"activity","detail":"Rental boats put in near La Roque-Gageac and drift under Beynac and Castelnaud, a half day of easy flat water paddling.","season":[5,6,7,8,9],"evidence":{"n_sources":4,"of":11,"urls":["https://avagabondlife.com/the-top-10-things-to-do-in-sarlat/","https://lifeinruralfrance.com/things-to-do-in-sarlat/","https://touristear.com/en/best-things-to-do-sarlat-la-caneda-dordogne-perigord/","https://www.bontraveler.com/sarlat-la-caneda-france/"],"method":"web"},"sources":["web"]},{"name":"Prehistoric caves of the Vezere valley","type":"activity","