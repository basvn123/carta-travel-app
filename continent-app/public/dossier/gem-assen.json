hopping and services.","grounding":[{"source":"wikivoyage","title":"Assen","url":"https://en.wikivoyage.org/wiki/Assen","licence":"CC BY-SA 4.0"}],"short":"Assen is a city of seventy thousand in the Netherlands, the seat of Drenthe. The Drents Museum is the strongest hour or two, and Drentsche Aa National Park runs alongside the town. Ten hours fills a day here, with June to August the best of it.","short_src":"rewrite","facts":{"population":68836,"visit_h":7.2}},"highlights":[{"id":"hl-drents-museum","name":"Drents Museum","kind":"Museum","lat":52.99333,"lon":6.56417,"dist_km":0.4,"rank_score":9.02,"resolved_by":"catalogue","image":{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/3/3c/Drents_Museum.jpg/500px-Drents_Museum.jpg","author":"CrazyPhunk","licence":"CC BY-SA 3.0","licence_url":"http://creativecommons.org/licenses/by-sa/3.0/","page":"https://commons.wikimedia.org/wiki/File:Drents_Museum.jpg","w":800,"h":601,"ok_print":true}},{"id":"hl-drentsche-aa-national-park","name":"Drentsche Aa National Park","kind":"National park","lat":53.04161,"lon":6.64945,"dist_km":7.7,"rank_score":6.85,"resolved_by":"catalogue","image":{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/f/f9/Kymmelsberg_Schipborg.jpg/960px-Kymmelsberg_Schipborg.jpg","author":"Gouwenaar","licence":"Public domain","page":"https://commons.wikimedia.org/wiki/File:Kymmelsberg_Schipborg.jpg","w":2589,"h":958,"ok_print":true}}],"do":[{"name":"Hoornse Meer","type":"swim","detail":"21 km away, water rated Excellent","ref":{"layer":"lakes","cc":"NL","id":"nl-hoornse-meer-Q2550802"},"sources":["eea","layer"],"evidence":{"method":"open","n_sources":2,"sources":["eea","layer"]}},{"name":"Paterswoldsemeer","type":"swim","detail":"19 km away, water rated Excellent","ref":{"layer":"lakes","cc":"NL","id":"nl-paterswoldsemeer-Q2179826"},"sources":["eea","layer"],"evidence":{"method":"open","n_sources":2,"sources":["eea","layer"]}},{"name":"TT Circuit Assen","type":"activity","sources":["wikiv