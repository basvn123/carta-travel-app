commons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Alba_alla_Valle_del_Bove_-_Etna.jpg","w":5184,"h":3456,"ok_print":true}},{"id":"hl-basilica-of-st-sebastian","name":"Basilica of St. Sebastian","kind":"Basilica","lat":37.6115,"lon":15.1655,"dist_km":21.9,"rank_score":6.17,"resolved_by":"catalogue","image":{"url":"https://commons.wikimedia.org/wiki/Special:FilePath/Acireale%20-%20Basilica%20collegiata%20di%20San%20Sebastiano%20-%202023-09-08%2016-40-03%20001.jpg?width=960","author":"Francyort985","licence":"CC BY-SA 4.0","licence_url":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Acireale_-_Basilica_collegiata_di_San_Sebastiano_-_2023-09-08_16-40-03_001.jpg","w":4160,"h":3120,"ok_print":true}},{"id":"hl-castello-normanno","name":"Castello Normanno","kind":"Castle","lat":37.56545,"lon":14.89369,"dist_km":22.9,"rank_score":5.95,"resolved_by":"catalogue","image":{"url":"https://commons.wikimedia.org/wiki/Special:FilePath/Castello%20normanno%20paterno.jpg?width=960","author":"Antonio Caruso at Italian Wikipedia","licence":"CC BY-SA 3.0","licence_url":"http://creativecommons.org/licenses/by-sa/3.0/","page":"https://commons.wikimedia.org/wiki/File:Castello_normanno_paterno.jpg","w":671,"h":809,"ok_print":true}}],"do":[{"name":"Etna wine tasting on the volcano slopes","type":"experience","detail":"Winery lunches on the volcanic flanks: Nerello Mascalese reds and mineral Carricante whites grown in black ash soil, often paired with a crater stop.","link":"https://www.viator.com/tours/Catania/Tour-Etna-and-Wine-Tasting/d22664-182784P2","evidence":{"n_sources":8,"of":22,"urls":["https://www.winetourism.com/wine-tasting-tours-in-etna/","https://www.go-etna.com/sicily-wine-tours/etna-wine-tour/","https://www.viator.com/tours/Catania/Tour-Etna-and-Wine-Tasting/d22664-182784P2"],"method":"web"},"sources":["web"]},{"name":"Circumetnea railway around the volcano","type":"experience","detail":"Narrow-gauge train looping 110 km around Etna's base through lava fields and towns like Bronte and Randazzo; hop off midway to explore.","link":"https://www.italia.it/en/sicily/things-to-do/circumetnea-railway-a-tour-of-etna-volcano","evidence":{"n_sources":8,"of":22,"urls":["https://www.italia.it/en/sicily/things-to-do/circumetnea-railway-a-tour-of-etna-volcano","https://www.hourrail.voyage/en/blog/la-circumetnea-etna-sicile","https://lovetravellingblog.com/2019/10/08/day-5-a-ride-on-the-circumetnea-railway-around-mt-etna-sicily/"],"method":"web"},"sources":["web"]},{"name":"Summit crater trek with a volcano guide","type":"trail","detail":"Cable car and 4x4 from Rifugio Sapienza to about 2,800 m, then a guided walk to the rim of Bocca Nuova near 3,300 m with views to the Aeolians.","season":[4,5,6,7,8,9,10],"link":"https://www.getyourguide.com/catania-l258/etna-summit-craters-trekking-with-volcano-guide-3350mt-t227776/","evidence":{"n_sources":7,"of":22,"urls":["https://www.getyourguide.com/catania-l258/etna-summit-craters-trekking-with-volcano-guide-3350mt-t227776/","https://www.funiviaetna.com/","https://www.earthtrekkers.com/mount-etna/"],"method":"web"},"sources":["web"]},{"name":"Silvestri craters loop","type":"trail","detail":"Free, easy path around the 1892 Silvestri craters beside Rifugio Sapienza; red cinder rims and Valle del Bove views without a guide.","evidence":{"n_sources":6,"of":22,"urls":["https://www.outdooractive.com/en/route/hiking-trail/province-of-catania/crateri-silvestri-silvestri-craters/46796753/","https://www.lonelyplanet.com/articles/how-to-hike-mount-etna-sicily","https://theculturetrip.com/europe/italy/articles/the-essential-guide-to-hiking-mount-etna-sicily"],"method":"web"},"sources":["web"]},{"name":"Lava tube caves","type":"activity","detail":"Guided tours duck into tunnels left by old flows, from roadside caves near the south side to the 2002 eruption tube, helmet and torch supplied.","evidence":{"n_sources":4,"of":22,"urls":["https://www.lo