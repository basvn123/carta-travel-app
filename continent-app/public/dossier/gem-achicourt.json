 from the town hall.","evidence":{"n_sources":4,"of":13,"urls":["https://www.carrierewellington.com/city-pass-wellington/","https://www.lagazettefrance.fr/article/arras-du-coeur-de-ville-a-la-carriere-de-wellington","https://www.escapades-en-hautsdefrance.com/week-end-a-arras/"],"method":"web"},"sources":["web"]}],"trips":[{"kind":"destination","id":"gem:ablain-saint-nazaire","name":"Ablain-Saint-Nazaire","country":"France","dist_km":14,"travel":{"minutes":25,"mode":"car","source":"trip_model"},"why":["worthTheRide"],"lat":50.3932,"lon":2.7088,"rating":{"score":7.3,"label":"Worth a visit","hidden_gem":true},"blurb":"Battle of Vimy Ridge - April 9th - 12th, 1917 and Canadian National Vimy Memorial.","visit_h":3.6,"image":{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/4/4c/Ablain-eglise07.jpg/500px-Ablain-eglise07.jpg"}},{"kind":"destination","id":"gem:loos-en-gohelle","name":"Loos-en-Gohelle","country":"France","dist_km":21,"travel":{"minutes":33,"mode":"train","source":"trip_model"},"why":["worthTheRide"],"lat":50.45786,"lon":2.79215,"rating":{"score":7.4,"label":"Worth a visit"},"blurb":"Battle of Vimy Ridge - April 9th - 12th, 1917 and Battle of Loos.","visit_h":3.6,"image":{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/6/69/Loos-en-Gohelle_-_Fosse_n%C2%B0_11_-_19_des_mines_de_Lens_%28128%29.JPG/500px-Loos-en-Gohelle_-_Fosse_n%C2%B0_11_-_19_des_mines_de_Lens_%28128%29.JPG"}},{"kind":"destination","id":"gem:mailly-maillet","name":"Mailly-Maillet","country":"France","dist_km":24,"travel":{"minutes":35,"mode":"train","source":"trip_model"},"why":["worthTheRide"],"lat":50.08025,"lon":2.60473,"rating":{"score":7.2,"label":"Worth a visit","hidden_gem":true},"blurb":"Thiepval Memorial Park and Thiepval Memorial to the Missing of the Somme 1915 - 1918.","visit_h":3.5,"image":{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/3/3e/Mailly-Maillet%2C_Somme%2C_France.jpg/500px-Mailly-Maillet%2C_Somme%2C_France.jpg"}},{"kind":"destination"