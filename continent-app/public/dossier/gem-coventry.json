ity, visitors should not expect much in the way of old-world charm.","grounding":[{"source":"wikivoyage","title":"Coventry","url":"https://en.wikivoyage.org/wiki/Coventry","licence":"CC BY-SA 4.0"}],"facts":{"population":345324,"visit_h":16.8}},"highlights":[{"id":"hl-coventry-cathedral","name":"Coventry Cathedral","kind":"Cathedral","lat":52.40833,"lon":-1.50722,"dist_km":0.4,"rank_score":11.08,"resolved_by":"catalogue","image":{"url":"https://commons.wikimedia.org/wiki/Special:FilePath/Coventry%20Cathedral%202018.jpg?width=960","author":"DeFacto","licence":"CC BY-SA 4.0","licence_url":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Coventry_Cathedral_2018.jpg","w":4125,"h":3084,"ok_print":true},"merged_from":["Coventry Cathedral Church of St Michael"]},{"id":"hl-coventry-building-society-arena","name":"Coventry Building Society Arena","kind":"Landmark","lat":52.44806,"lon":-1.49556,"dist_km":4.8,"rank_score":9.93,"resolved_by":"catalogue"},{"id":"hl-kenilworth-castle","name":"Kenilworth Castle","kind":"Museum","lat":52.347,"lon":-1.59111,"dist_km":8.5,"rank_score":7.93,"resolved_by":"catalogue","image":{"url":"https://commons.wikimedia.org/wiki/Special:FilePath/Kenilworth%20Castle%202016.jpg?width=960","author":"DeFacto","licence":"CC BY-SA 4.0","licence_url":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Kenilworth_Castle_2016.jpg","w":4896,"h":3264,"ok_print":true}},{"id":"hl-belgrade-theatre","name":"Belgrade Theatre","kind":"Theatre","lat":52.40983,"lon":-1.51439,"dist_km":0.4,"rank_score":5.5,"resolved_by":"catalogue","heritage":true},{"id":"hl-statue-of-lady-godiva","name":"Statue of Lady Godiva","kind":"Monument","lat":52.40803,"lon":-1.51042,"dist_km":0.2,"rank_score":5.5,"resolved_by":"retyped","heritage":true},{"id":"hl-war-memorial-park","name":"War Memorial Park","kind":"Monument","lat":52.39202,"lon":-1.52317,"dist_km":1.8,"rank_score":5.5,"resolved_by":