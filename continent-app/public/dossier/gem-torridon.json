ad a combined population of 410.","grounding":[{"source":"wikivoyage","title":"Torridon","url":"https://en.wikivoyage.org/wiki/Torridon","licence":"CC BY-SA 4.0"}],"short":"Torridon is a wilderness area in the United Kingdom, ringed by the peaks of Liathach and Beinn Eighe above Loch Maree. Tom na Gruagaich and Beinn Liath Mhor extend the hiking to seven hours, best tackled June through August with little public transport.","short_src":"rewrite","facts":{"visit_h":4.9}},"highlights":[{"id":"hl-loch-maree","name":"Loch Maree","kind":"Lake","lat":57.68972,"lon":-5.4575,"dist_km":16.0,"rank_score":8.07,"resolved_by":"catalogue"},{"id":"hl-beinn-eighe","name":"Beinn Eighe","kind":"Peak","lat":57.37,"lon":-5.24,"dist_km":26.1,"rank_score":7.22,"resolved_by":"catalogue"},{"id":"hl-a-mhaighdean","name":"A' Mhaighdean","kind":"Peak","lat":57.71965,"lon":-5.34672,"dist_km":21.5,"rank_score":6.98,"resolved_by":"catalogue","image":{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/c/cf/A-Mhaighdean-from-Slioch.jpg/960px-A-Mhaighdean-from-Slioch.jpg","author":"John Wood","licence":"CC BY-SA 3.0","licence_url":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:A-Mhaighdean-from-Slioch.jpg","w":1195,"h":686,"ok_print":true}},{"id":"hl-liathach","name":"Liathach","kind":"Peak","lat":57.56433,"lon":-5.46212,"dist_km":3.8,"rank_score":6.85,"resolved_by":"catalogue","image":{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/e/e1/Liathach_from_Loch_Clair_May_2006_-_geograph.org.uk_-_282854.jpg/960px-Liathach_from_Loch_Clair_May_2006_-_geograph.org.uk_-_282854.jpg","author":"Roddy Smith","licence":"CC BY-SA 2.0","licence_url":"https://creativecommons.org/licenses/by-sa/2.0","page":"https://commons.wikimedia.org/wiki/File:Liathach_from_Loch_Clair_May_2006_-_geograph.org.uk_-_282854.jpg","ok_print":true}},{"id":"hl-beinn-alligin","name":"Beinn Alligin","kind":"Peak","lat":57.59081,"lon":-5.57283,"dist_km":5.5,"rank_score":