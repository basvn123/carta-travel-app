assis","url":"https://en.wikivoyage.org/wiki/Cassis","licence":"CC BY-SA 4.0"}],"short":"Cassis is a fishing port in Provence, southern France, wedged between the headland of Cap Canaille and the Calanques National Park. Port-Pin and En-Vau are the coves worth the walk, about six hours all told. June to August, and a car helps.","short_src":"rewrite","facts":{"population":8361,"visit_h":4.3}},"highlights":[{"id":"hl-stade-velodrome","name":"Stade Vélodrome","kind":"Landmark","lat":43.26924,"lon":5.39491,"dist_km":13.0,"rank_score":10.65,"resolved_by":"catalogue","image":{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/a/a6/Stade_V%C3%A9lodrome_closeup.jpg/960px-Stade_V%C3%A9lodrome_closeup.jpg","author":"Bernard Ddd","licence":"CC BY-SA 2.0","licence_url":"https://creativecommons.org/licenses/by-sa/2.0","page":"https://commons.wikimedia.org/wiki/File:Stade_V%C3%A9lodrome_closeup.jpg","w":5347,"h":3565,"ok_print":true}},{"id":"hl-notre-dame-de-la-garde","name":"Notre-Dame de la Garde","kind":"Basilica","lat":43.28395,"lon":5.37123,"dist_km":15.5,"rank_score":9.58,"resolved_by":"catalogue","image":{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/3/3e/Notre_Dame_de_la_Garde_%E5%AE%88%E8%AD%B7%E8%81%96%E6%AF%8D%E9%99%A2_-_panoramio_%281%29.jpg/960px-Notre_Dame_de_la_Garde_%E5%AE%88%E8%AD%B7%E8%81%96%E6%AF%8D%E9%99%A2_-_panoramio_%281%29.jpg","author":"lienyuan lee","licence":"CC BY 3.0","licence_url":"https://creativecommons.org/licenses/by/3.0","page":"https://commons.wikimedia.org/wiki/File:Notre_Dame_de_la_Garde_%E5%AE%88%E8%AD%B7%E8%81%96%E6%AF%8D%E9%99%A2_-_panoramio_(1).jpg","w":2560,"h":1792,"ok_print":true}},{"id":"hl-cap-canaille","name":"Cap Canaille","kind":"Peak","lat":43.1947,"lon":5.54943,"dist_km":2.6,"rank_score":8.48,"resolved_by":"catalogue","image":{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/d/d9/Cap_Canaille_small.png/500px-Cap_Canaille_small.png","author":"Nnardelli","licence":"CC BY-SA 3.0","licence_url":"ht