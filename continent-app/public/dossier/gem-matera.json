.org/wiki/File:Duomo_di_matera,_esterno_01.jpg","w":3032,"h":2160,"ok_print":true}}],"do":[{"name":"Gravina gorge hike to Belvedere Murgia Timone","type":"trail","detail":"Drop into the ravine from Porta Pistola, cross the 130 m Tibetan bridge and climb to the belvedere for the classic full-sassi panorama.","evidence":{"n_sources":7,"of":10,"urls":["https://www.earthtrekkers.com/best-things-to-do-in-matera/","https://www.neverendingvoyage.com/sassi-matera-italy/","https://bestthingstodoin.city/things-to-do-in-matera/","https://en.wikivoyage.org/wiki/Matera"],"method":"web"},"sources":["web"]},{"name":"Rupestrian cave churches of the sassi and Murgia","type":"activity","detail":"Frescoed rock churches on both sides of the gorge: Madonna de Idris on its crag, San Pietro Barisano, and about 150 more in the park.","evidence":{"n_sources":7,"of":10,"urls":["https://www.neverendingvoyage.com/sassi-matera-italy/","https://www.wanderluststorytellers.com/things-to-do-in-matera/","https://alifeofy.com/things-to-do-in-matera/","https://en.wikivoyage.org/wiki/Matera"],"method":"web"},"sources":["web"]},{"name":"Palombaro Lungo underground cistern","type":"activity","detail":"A cathedral-sized water cistern under Piazza Vittorio Veneto, hand-carved chambers up to 15 m high that held 5 million litres.","evidence":{"n_sources":5,"of":10,"urls":["https://www.earthtrekkers.com/best-things-to-do-in-matera/","https://alifeofy.com/things-to-do-in-matera/","https://bestthingstodoin.city/things-to-do-in-matera/"],"method":"web"},"sources":["web"]},{"name":"Sunset aperitivo over the sassi","type":"experience","detail":"At golden hour the stone city glows; take a terrace drink or the belvederes near Via Ridola and Piazza Giovanni Pascoli.","evidence":{"n_sources":5,"of":10,"urls":["https://www.earthtrekkers.com/best-things-to-do-in-matera/","https://rachelirl.com/things-to-do-in-matera/","https://bestthingstodoin.city/things-to-do-in-matera/"],"method":"web"},"sources":["web"]},{"name":"Sleep in a cave hotel","type":"experience","detail":"Restored grotto dwellings in the sassi now house cave hotels, vaulted stone rooms that are the defining Matera overnight.","evidence":{"n_sources":4,"of":10,"urls":["https://rachelirl.com/things-to-do-in-matera/","https://www.wanderluststorytellers.com/things-to-do-in-matera/","https://bestthingstodoin.city/things-to-do-in-matera/"],"method":"web"},"sources":["web"]},{"name":"Festa della Bruna","type":"festival","detail":"Matera's 600 year old feast on 2 July: dawn procession, mounted knights, then the crowd tears apart the papier-mache cart at night.","season":[7],"link":"https://www.festadellabruna.it/","evidence":{"n_sources":4,"of":10,"urls":["https://www.neverendingvoyage.com/sassi-matera-italy/","https://alifeofy.com/things-to-do-in-matera/","https://it.wikipedia.org/wiki/Festa_della_Bruna","https://www.festadellabruna.it/"],"method":"web"},"sources":["web"]},{"name":"Casa Grotta di Vico Solitario","type":"activity","detail":"A furnished cave house showing how sassi families lived with animals and cistern before the 1950s evacuations; entry costs a few euros.","evidence":{"n_sources":4,"of":10,"urls":["https://www.earthtrekkers.com/best-things-to-do-in-matera/","https://www.neverendingvoyage.com/sassi-matera-italy/","https://alifeofy.com/things-to-do-in-matera/"],"method":"web"},"sources":["web"]},{"name":"Park of the Rupestrian Churches of Matera","type":"activity","sources":["wikidata","wikivoyage"],"evidence":{"method":"open","n_sources":2,"sources":["wikidata","wikivoyage"],"curated":"wikivoyage_do"}},{"name":"Guided tours","type":"activity","sources":["wikivoyage"],"evidence":{"method":"open","n_sources":1,"sources":["wikivoyage"],"curated":"wikivoyage_do"}},{"name":"Ape nei Sassi","type":"activity","sources":["wikivoyage"],"evidence":{"method":"open","n_sources":1,"sources":["wikivoyage"],"curated":"wikivoyage_do"}}],"around":{"radius_km":20,"counts":{"trails":2},"trails":[{"cc":"IT","id":"203819","name"