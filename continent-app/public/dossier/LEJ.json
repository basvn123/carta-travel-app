aus","name":"Gewandhaus","kind":"Theatre","lat":51.33781,"lon":12.38061,"dist_km":0.5,"sig":2.964,"rank_score":11.24,"resolved_by":"catalogue","fact":"Concert hall in Leipzig, Germany","image":{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/6/60/Das_Gewandhaus_und_der_Mendebrunnen_in_Leipzig_bei_Nacht.jpg/960px-Das_Gewandhaus_und_der_Mendebrunnen_in_Leipzig_bei_Nacht.jpg","author":"Ichwarsnur","licence":"CC BY-SA 4.0","licence_url":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Das_Gewandhaus_und_der_Mendebrunnen_in_Leipzig_bei_Nacht.jpg","ok_print":true},"wikipedia":"https://en.wikipedia.org/wiki/Gewandhaus","heritage":true},{"id":"hl-thomaskirche-17","name":"Thomaskirche #17","kind":"Church","lat":51.33921,"lon":12.37191,"dist_km":0.2,"sig":2.98,"rank_score":10.14,"resolved_by":"catalogue","fact":"Church in Leipzig, Germany","image":{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/3/36/Leipzig_Thomaskirche.jpg/960px-Leipzig_Thomaskirche.jpg","author":"Dirk Goldhahn","licence":"Public domain","page":"https://commons.wikimedia.org/wiki/File:Leipzig_Thomaskirche.jpg","ok_print":true},"wikipedia":"https://en.wikipedia.org/wiki/St._Thomas_Church,_Leipzig","heritage":true,"merged_from":["St. Thomas Church"]},{"id":"hl-monument-to-the-battle-of-the-nations","name":"Monument to the Battle of the Nations","kind":"Monument","lat":51.31247,"lon":12.41352,"dist_km":4.1,"sig":2.987,"rank_score":10.14,"resolved_by":"retyped","fact":"Monument in Leipzig, Germany","image":{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/c/cf/V%C3%B6lkerschlachtdenkmal_Leipzig_beim_Nacht.jpg/960px-V%C3%B6lkerschlachtdenkmal_Leipzig_beim_Nacht.jpg","author":"Stein53","licence":"CC BY-SA 4.0","licence_url":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:V%C3%B6lkerschlachtdenkmal_Leipzig_beim_Nacht.jpg","ok_print":true},"wikipedia":"https://en.wikipedia.org/wiki/Mon