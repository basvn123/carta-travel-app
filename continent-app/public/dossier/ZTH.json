nd":"Landmark","lat":37.79351,"lon":20.90034,"dist_km":1.5,"rank_score":1.2,"resolved_by":"retyped"}],"do":[{"name":"Boat to Navagio and the Blue Caves","type":"activity","detail":"Half day runs from Agios Nikolaos take in the wreck cove under white cliffs and the arches where the water glows blue.","season":[5,6,7,8,9,10],"evidence":{"n_sources":9,"of":27,"urls":["https://www.discovergreece.com/travel-ideas/best-of/9-things-to-do-in-zante-zakynthos","https://www.greeka.com/ionian/zakynthos/things-to-do/","https://www.thethinkingtraveller.com/blog/the-best-things-to-do-in-zakynthos","https://www.viator.com/en-GB/Ionian-Islands-attractions/Blue-Caves/d4277-a19893","https://www.heatheronhertravels.com/shipwrecks-or-turtles-boat-trip-on-zakynthos-greece/"],"method":"web"},"sources":["web"]},{"name":"Turtle spotting off Marathonisi","type":"activity","detail":"Small kaiki boats leave Keri for the nesting bay, where loggerheads surface, then carry on into the sea caves at Keri.","season":[5,6,7,8,9,10],"link":"https://www.getyourguide.com/marathonisi-caves-l146611/","evidence":{"n_sources":7,"of":27,"urls":["https://www.getyourguide.com/marathonisi-caves-l146611/","https://www.tripadvisor.com/AttractionProductReview-g658915-d12470370-Zakynthos_Keri_Caves_Marathonissi_and_Turtle_Spotting_Kaiki_Boat_Trip-Laganas_Zaky.html","https://www.viator.com/tours/Zakynthos/Zakynthos-Semi-PrivateTurtle-spotting-Keri-caves-Marathonisi-and-Cameo-island/d23524-239318P8","https://www.thethinkingtraveller.com/blog/the-best-things-to-do-in-zakynthos","https://www.discovergreece.com/travel-ideas/best-of/9-things-to-do-in-zante-zakynthos"],"method":"web"},"sources":["web"]},{"name":"Snorkel the inlet at Porto Limnionas","type":"swim","detail":"Stone steps drop into a narrow rock cove on the west coast, with swim through caverns on the left wall and purple starfish below.","season":[6,7,8,9],"link":"https://www.snorkeling-report.com/spot/snorkeling-porto-limnionas-zakynthos/","evidence":{"n_so