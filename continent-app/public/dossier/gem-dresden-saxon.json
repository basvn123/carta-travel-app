ge.org/wiki/Saxon_Switzerland","licence":"CC BY-SA 4.0"}],"short":"Saxon Switzerland is walking country in Germany, sandstone towers in the Elbe Sandstone Mountains. Konigstein Fortress and Saxon Switzerland National Park lead about four hours of fixed sights. May to September is the season, and public transport is poor.","short_src":"rewrite","facts":{"population":2234,"visit_h":3.6}},"highlights":[{"id":"hl-gohrisch","name":"Gohrisch","kind":"Peak","lat":50.90109,"lon":14.11201,"dist_km":2.7,"sig":1.306,"rank_score":9.83,"resolved_by":"catalogue","fact":"Municipality in Saxony, Germany","wikipedia":"https://en.wikipedia.org/wiki/Gohrisch"},{"id":"hl-elbe-sandstone-mountains","name":"Elbe Sandstone Mountains","kind":"Peak","lat":50.85,"lon":14.12,"dist_km":4.6,"rank_score":9.79,"resolved_by":"catalogue","image":{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/2/29/Lilienstein_herbstabend.jpeg/960px-Lilienstein_herbstabend.jpeg","author":"Iven Eissner","licence":"CC BY-SA 3.0","licence_url":"http://creativecommons.org/licenses/by-sa/3.0/","page":"https://commons.wikimedia.org/wiki/File:Lilienstein_herbstabend.jpeg","ok_print":true}},{"id":"hl-saxon-switzerland-national-park","name":"Saxon Switzerland National Park","kind":"National park","lat":50.9142,"lon":14.2784,"dist_km":14.1,"rank_score":9.46,"resolved_by":"catalogue","image":{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/4/4a/Basteibr%C3%BCcke_morgens_%28Zuschnitt%29.jpg/960px-Basteibr%C3%BCcke_morgens_%28Zuschnitt%29.jpg","author":"Thomas Wolf, www.foto-tw.de","licence":"CC BY-SA 3.0 de","licence_url":"https://creativecommons.org/licenses/by-sa/3.0/de/deed.en","page":"https://commons.wikimedia.org/wiki/File:Basteibr%C3%BCcke_morgens_(Zuschnitt).jpg","w":4825,"h":3452,"ok_print":true}},{"id":"hl-konigstein-fortress","name":"Königstein Fortress","kind":"Castle","lat":50.91917,"lon":14.05802,"dist_km":4.2,"sig":2.483,"rank_score":9.34,"resolved_by":"catalogue","fact":"Hilltop fortificat