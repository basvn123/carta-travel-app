_Lacul_Bucurelu.jpg/960px-Lacul_Bucura%2C_Lacul_Ana_a_Lacul_Bucurelu.jpg","author":"Dezidor","licence":"CC BY 3.0","licence_url":"https://creativecommons.org/licenses/by/3.0","page":"https://commons.wikimedia.org/wiki/File:Lacul_Bucura,_Lacul_Ana_a_Lacul_Bucurelu.jpg","w":2816,"h":2112,"ok_print":true}},{"id":"hl-peleaga","name":"Peleaga","kind":"Peak","lat":45.36611,"lon":22.89444,"dist_km":5.8,"rank_score":9.2,"resolved_by":"catalogue","image":{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/3/37/Vf-peleaga6.jpg/960px-Vf-peleaga6.jpg","author":"Hardsr","licence":"Public domain","page":"https://commons.wikimedia.org/wiki/File:Vf-peleaga6.jpg","w":2840,"h":1946,"ok_print":true}},{"id":"hl-retezat-mountains","name":"Retezat Mountains","kind":"Peak","lat":45.36667,"lon":22.86667,"dist_km":4.1,"rank_score":8.07,"resolved_by":"catalogue"},{"id":"hl-ulpia-traiana-sarmizegetusa","name":"Ulpia Traiana Sarmizegetusa","kind":"Ruins","lat":45.51735,"lon":22.78765,"dist_km":20.0,"rank_score":7.78,"resolved_by":"catalogue"}],"do":[{"name":"Walk up to Lake Bucura","type":"trail","detail":"The largest glacial lake in Romania, ice cold and ringed by peaks. About 6.6 km and three hours up from the Poiana Pelegii campsite, with a second campsite at the lake itself.","season":[6,7,8,9],"evidence":{"n_sources":9,"of":14,"urls":["https://www.komoot.com/guide/159450/hiking-around-retezat","https://www.tripadvisor.com/ShowUserReviews-g3396823-d12204346-r760930355-Parcul_National_Retezat-Rausor_Hunedoara_County_Western_Romania_Transylvania.html","https://airial.travel/attractions/romania/bucura-lake-retezat-national-park-IiTlTQDR"],"method":"web"},"sources":["web"]},{"name":"Peleaga and Papusa peaks","type":"trail","detail":"Peleaga at 2,509 m is the highest in the range and Papusa a metre behind it. The circuit from Poiana Pelegii is about 12.4 km and six hours, over more than fifty summits above 2,000 m.","season":[7,8,9],"evidence":{"n_sources":7,"of":14,"urls":["https://ww