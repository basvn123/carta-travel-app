 4.0"}],"short":"Lanark is a historic town in the United Kingdom, with New Lanark as its best known sight. Craignethan Castle and Douglas Castle add two more, with the Falls of Clyde and Cleghorn Glen nearby. Its sights take six hours, best from June to August.","short_src":"rewrite","facts":{"population":8880,"visit_h":6}},"highlights":[{"id":"hl-craignethan-castle","name":"Craignethan Castle","kind":"Castle","lat":55.69603,"lon":-3.88542,"dist_km":7.0,"sig":2.483,"rank_score":7.77,"resolved_by":"catalogue","fact":"16th-century Scottish castle","image":{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/2/2d/Craignethan_Castle.jpg/960px-Craignethan_Castle.jpg","author":"No machine-readable author provided. Supergolden assumed (based on copyright claims)","licence":"CC BY-SA 3.0","licence_url":"http://creativecommons.org/licenses/by-sa/3.0/","page":"https://commons.wikimedia.org/wiki/File:Craignethan_Castle.jpg","w":1600,"h":1200,"ok_print":true},"wikipedia":"https://en.wikipedia.org/wiki/Craignethan_Castle","heritage":true},{"id":"hl-falls-of-clyde","name":"Falls of Clyde","kind":"Waterfall","lat":55.65468,"lon":-3.77149,"dist_km":2.2,"rank_score":6.7,"resolved_by":"catalogue"},{"id":"hl-douglas-castle","name":"Douglas Castle","kind":"Castle","lat":55.56645,"lon":-3.83718,"dist_km":12.4,"rank_score":5.95,"resolved_by":"catalogue","image":{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/6/69/DouglasCastle02.jpg/960px-DouglasCastle02.jpg","author":"User:Supergolden","licence":"CC BY-SA 3.0","licence_url":"http://creativecommons.org/licenses/by-sa/3.0/","page":"https://commons.wikimedia.org/wiki/File:DouglasCastle02.jpg","w":1200,"h":1600,"ok_print":true}},{"id":"hl-cleghorn-glen","name":"Cleghorn Glen","kind":"Nature reserve","lat":55.689,"lon":-3.768,"dist_km":1.9,"sig":2.506,"rank_score":5.8,"resolved_by":"catalogue","fact":"Protected area in South Lanarkshire, Scotland","image":{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/7/73/