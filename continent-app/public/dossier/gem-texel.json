ge.org/wiki/Texel","licence":"CC BY-SA 4.0"}],"short":"Texel is a quiet island in the Netherlands, good for families. Dunes of Texel National Park, the Eierland Lighthouse and Museum Kaap Skil lead seven hours, near Vliehors, best kept to June, July or August.","short_src":"rewrite","facts":{"population":6485,"visit_h":4.9}},"highlights":[{"id":"hl-wieringen","name":"Wieringen","kind":"Island","lat":52.9,"lon":4.97,"dist_km":20.5,"rank_score":9.97,"resolved_by":"catalogue","image":{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/7/7a/Oosterland_Wieringen.jpg/960px-Oosterland_Wieringen.jpg","author":"Jan Arkesteijn","licence":"Public domain","page":"https://commons.wikimedia.org/wiki/File:Oosterland_Wieringen.jpg","w":1200,"h":800,"ok_print":true}},{"id":"hl-eierland-lighthouse","name":"Eierland Lighthouse","kind":"Lighthouse","lat":53.18194,"lon":4.85528,"dist_km":14.9,"rank_score":7.87,"resolved_by":"catalogue","image":{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/4/45/Eierland_Lighthouse_texel.jpg/960px-Eierland_Lighthouse_texel.jpg","author":"Yornik Heyl","licence":"CC BY-SA 3.0","licence_url":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Eierland_Lighthouse_texel.jpg","w":2289,"h":3434,"ok_print":true}},{"id":"hl-noorderhaaks","name":"Noorderhaaks","kind":"Island","lat":52.975,"lon":4.68056,"dist_km":11.6,"rank_score":7.52,"resolved_by":"catalogue","image":{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/7/70/Den_Helder_4.77628E_52.95026N.jpg/960px-Den_Helder_4.77628E_52.95026N.jpg","author":"NASA","licence":"Public domain","page":"https://commons.wikimedia.org/wiki/File:Den_Helder_4.77628E_52.95026N.jpg","w":1280,"h":958,"ok_print":true}},{"id":"hl-dunes-of-texel-national-park","name":"Dunes of Texel National Park","kind":"National park","lat":53.14583,"lon":4.8025,"dist_km":10.4,"rank_score":7.22,"resolved_by":"catalogue","image":{"url":"https://upload.wikimedia.org/wikip