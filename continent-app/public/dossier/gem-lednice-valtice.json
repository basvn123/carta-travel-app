ia.org/wiki/File:Lednice,_maursk%C3%A1_vod%C3%A1rna.jpg","w":2592,"h":1944,"ok_print":true},"wikipedia":"https://cs.wikipedia.org/wiki/Maursk%C3%A1_vod%C3%A1rna","heritage":true},{"id":"hl-januv-hrad","name":"Janův hrad","kind":"Castle","lat":48.80332,"lon":16.83195,"dist_km":5.2,"sig":2.883,"rank_score":6.61,"resolved_by":"retyped","fact":"umělá zřícenina u obce Lednice v Lednicko-Valtickém areálu","image":{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/e/e9/Januv_hrad%2C_Lednice.JPG/960px-Januv_hrad%2C_Lednice.JPG","author":"Michal Klajban","licence":"CC BY-SA 4.0","licence_url":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Januv_hrad,_Lednice.JPG","ok_print":true},"wikipedia":"https://cs.wikipedia.org/wiki/Jan%C5%AFv_hrad","heritage":true}],"do":[{"name":"Ride the Liechtenstein cycling trails","type":"trail","detail":"Roughly 200 km of flat marked routes link the follies, vineyards and fishponds, so a bike covers far more of the park than a car.","season":[4,5,6,7,8,9,10],"evidence":{"n_sources":5,"of":19,"urls":["https://www.visitczechia.com/en-us/things-to-do/places/summer-sports/cycling/s-lednice-valtice-cycling","https://visitworldheritage.com/en/eu/cycling-trails/ecbf291c-d933-4640-af95-809ed3708f8f","http://www.cycling-southern-moravia-region.com/liechtenstein-trails-lednice-trail","https://explorationvacation.net/wander-czechias-lednice-valtice-area/","https://www.south-moravia.com/en/experiences/o58193-lednice-valtice-area"],"method":"web"},"sources":["web"]},{"name":"Taste your way through the Valtice Wine Salon","type":"experience","detail":"A hundred wines that won the national tasting sit in a vaulted cellar under the chateau, poured at your own pace over two hours.","evidence":{"n_sources":5,"of":19,"urls":["https://www.visitczechia.com/en-us/things-to-do/places/landmarks/unesco/c-lednice-valtice-area-unesco","https://visitworldheritage.com/en/eu/lednice-valtice-cultural-landscape-czechi