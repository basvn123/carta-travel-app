ust.","short_src":"rewrite","facts":{"visit_h":6.1}},"highlights":[{"id":"hl-glenfinnan-viaduct","name":"Glenfinnan Viaduct","kind":"Bridge","lat":56.87582,"lon":-5.42932,"dist_km":1.2,"sig":2.986,"rank_score":10.96,"resolved_by":"catalogue","fact":"Railway viaduct in the Highlands, Scotland","image":{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/1/10/Glenfinnan_Viaduct_-_2022.jpg/960px-Glenfinnan_Viaduct_-_2022.jpg","author":"Matthieu Riegler","licence":"CC BY 3.0","licence_url":"https://creativecommons.org/licenses/by/3.0","page":"https://commons.wikimedia.org/wiki/File:Glenfinnan_Viaduct_-_2022.jpg","ok_print":true},"wikipedia":"https://en.wikipedia.org/wiki/Glenfinnan_Viaduct","heritage":true},{"id":"hl-loch-morar","name":"Loch Morar","kind":"Lake","lat":56.95,"lon":-5.67222,"dist_km":16.3,"rank_score":9.52,"resolved_by":"catalogue"},{"id":"hl-sgurr-thuilm","name":"Sgùrr Thuilm","kind":"Peak","lat":56.93684,"lon":-5.38952,"dist_km":8.1,"sig":2.746,"rank_score":7.9,"resolved_by":"catalogue","fact":"Mountain in Scotland","image":{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/8/8d/Sgurr_Thuilm_-_geograph.org.uk_-_636440.jpg/960px-Sgurr_Thuilm_-_geograph.org.uk_-_636440.jpg","author":"wfmillar","licence":"CC BY-SA 2.0","licence_url":"https://creativecommons.org/licenses/by-sa/2.0","page":"https://commons.wikimedia.org/wiki/File:Sgurr_Thuilm_-_geograph.org.uk_-_636440.jpg","ok_print":true},"wikipedia":"https://en.wikipedia.org/wiki/Sg%C3%B9rr_Thuilm"},{"id":"hl-loch-shiel","name":"Loch Shiel","kind":"Lake","lat":56.79111,"lon":-5.58704,"dist_km":12.3,"rank_score":7.78,"resolved_by":"catalogue"},{"id":"hl-streap","name":"Streap","kind":"Peak","lat":56.92307,"lon":-5.37619,"dist_km":7.2,"sig":2.715,"rank_score":7.57,"resolved_by":"catalogue","fact":"Mountain in Scotland","image":{"url":"https://upload.wikimedia.org/wikipedia/commons/f/f1/Streap_View_-_geograph.org.uk_-_266412.jpg","author":"Adam Ward","licence":"CC BY-SA 2.0","licence_url":"