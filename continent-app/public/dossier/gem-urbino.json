aces/urbino.php","https://visitlemarche.com/guides/urbino-a-unesco-renaissance-city-and-raphaels-birthplace/"],"method":"web"},"sources":["web"]},{"name":"Festa dell'Aquilone kite contest","type":"festival","detail":"Ten city quarters build kites by hand and fly them off the hills the first weekend of September, judged on height and on looks.","season":[9],"link":"https://festaquilone.it/","evidence":{"n_sources":7,"of":27,"urls":["https://festaquilone.it/","https://www.sharry.land/en/events/festa-dell-aquilone","https://www.italia.it/en/marche/urbino","https://vallenuova.it/things-to-do/festivals-and-fairs/attachment/9-f-urbino-kite-festival-september-marche-festa-dell-aquilone/","https://www.creativeedgetravel.com/post/10-unique-september-festivals-in-italy","https://kapjasa.si/en/sidekicks-the-69th-festa-dellaquilone-in-urbino-part-one/","https://www.hotelcasadei.it/eng/events/kite-festival-urbino-2024-colors-and-tradition-in-the-marche-sky/60/"],"method":"web"},"sources":["web"]},{"name":"Eat crescia sfogliata hot off the plate","type":"experience","detail":"A layered flatbread of flour, eggs and lard, folded around sausage, greens or cheese. Bars sell it cheaper and fresher than restaurants.","evidence":{"n_sources":7,"of":27,"urls":["https://www.italia.it/en/marche/things-to-do/typical-food-and-dishes-in-marche-italy","https://www.cellartours.com/blog/italy/le-marche-cuisine","https://massicooksitalian.substack.com/p/crescia-sfogliata-di-urbino","https://www.trips2italy.com/location/urbino/food-and-wine/","https://gustoeamore.com/2021/08/15/crescia-di-urbino/","https://theitalianontour.com/a-locals-guide-to-urbino-italy/","https://www.tenutasantigiacomoefilippo.it/en/news-events/crescia-sfogliata-di-urbino"],"method":"web"},"sources":["web"]},{"name":"Climb to Fortezza Albornoz park","type":"trail","detail":"A short uphill walk to the 14th century fort, where the lawn faces the palace towers, the dome and the brick roofs stacked against open hills.","evidence"