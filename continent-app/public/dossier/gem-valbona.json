ise","name":"Shpella e Dragobisë","kind":"Cave","lat":42.44511,"lon":19.94016,"dist_km":4.4,"sig":0.398,"rank_score":1.2,"resolved_by":"retyped"},{"id":"hl-ledena-pecina","name":"Ledena pećina","kind":"Cave","lat":42.49577,"lon":19.8913,"dist_km":4.7,"sig":0.398,"rank_score":1.2,"resolved_by":"retyped"}],"do":[{"name":"Valbona to Theth crossing","type":"trail","detail":"Point to point day hike over the 1795 m Valbona Pass to Theth, about 17 km and 6 to 9 hours on a marked trail.","season":[6,7,8,9],"link":"https://www.aaa.com/tripcanvas/thing-to-do/2-days-into-the-north-theth-and-valbona-explorer-with-lunch-440782P6","evidence":{"n_sources":16,"of":37,"urls":["https://www.laurewanders.com/valbona-to-theth-hike/","https://www.thebrokebackpacker.com/valbona-to-theth-trail/","https://imjesstraveling.com/valbona-pass-valbona-theth-hike/"],"method":"web"},"sources":["web"]},{"name":"Lake Koman ferry ride","type":"experience","detail":"Three hour ferry through the fjord-like Koman reservoir from Koman to Fierza, the classic scenic approach to Valbona.","evidence":{"n_sources":9,"of":37,"urls":["https://www.laurewanders.com/komani-lake-ferry/","https://adventurealbania.com/koman-lake-ferry/","https://www.traveltomtom.net/destinations/europe/albania/how-to-take-the-komani-lake-ferry-from-koman-to-fierza"],"method":"web"},"sources":["web"]},{"name":"Peaks of the Balkans stage","type":"trail","detail":"192 km circuit through Albania, Kosovo and Montenegro; Valbona is a main overnight stop with family guesthouses.","season":[6,7,8,9],"link":"https://zbulo.org/peaks-of-the-balkans/","evidence":{"n_sources":9,"of":37,"urls":["https://thehikinglife.com/2024/10/a-quick-dirty-guide-to-the-peaks-of-the-balkans-trail/","https://peaksofthebalkans.info/guest-houses/","https://zbulo.org/peaks-of-the-balkans/"],"method":"web"},"sources":["web"]},{"name":"Guesthouse farm dinners","type":"experience","detail":"Family-run guesthouses cook mountain staples for hikers: fli baked under a sac lid, cornbread, salty cheese, chestnut honey.","evidence":{"n_sources":5,"of":37,"urls":["https://lovealbania.al/valbona-national-park-travel-guide/","https://brookebeyond.com/pob-guesthouses","https://davidsbeenhere.com/2021/03/12/top-things-to-see-and-do-in-valbona-albania/"],"method":"web"},"sources":["web"]},{"name":"Rrogam waterfall walk","type":"trail","detail":"A roughly 25 m fall at the head of the valley, reached by a marked walk from Rrogam village about 3 km from Valbona.","season":[5,6,7,8,9,10],"evidence":{"n_sources":4,"of":37,"urls":["https://thesandyfeet.com/valbona-waterfall-albania/","https://lovealbania.al/valbona-national-park-travel-guide/","https://travelacrosstheborderline.com/things-to-do-in-valbona-albania/"],"method":"web"},"sources":["web"]},{"name":"Rosi Peak day hike","type":"trail","detail":"Border summit above the valley, rated its easiest peak; adds about 400 m of climb beyond the Valbona Pass.","season":[6,7,8,9],"evidence":{"n_sources":3,"of":37,"urls":["https://imjesstraveling.com/albanian-alps-hiking/","https://theholisticbackpacker.com/3-day-valbona-itinerary-valbona-hikes-things-to-do/","https://www.alltrails.com/parks/albania/valbona-valley-national-park"],"method":"web"},"sources":["web"]},{"name":"Swim at Xhemes Lake","type":"swim","detail":"Cold clear pools on the glacial-blue Valbona river; locals point swimmers to Xhemes Lake and the pool under Rrogam falls.","season":[6,7,8],"evidence":{"n_sources":3,"of":37,"urls":["https://travelacrosstheborderline.com/things-to-do-in-valbona-albania/","https://lovealbania.al/valbona-national-park-travel-guide/","https://albaniannight.com/9-things-to-do-in-valbona-valley-national-park/"],"method":"web"},"sources":["web"]},{"name":"Maja Kokervhake","type":"activity","detail":"Mountain range in Southeast Europe","sources":["osm","wikidata","wikipedia"],"evidence":{"method":"open","n_sources":3,"sources":["osm","wikidata","wikipedia"]}},{"name":"Valbonë Valley National Park","type":"activit