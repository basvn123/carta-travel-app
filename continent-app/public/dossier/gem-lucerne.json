ptember with around 30 symphony concerts by leading orchestras.","season":[8,9],"evidence":{"n_sources":3,"of":21,"urls":["https://en.wikipedia.org/wiki/Lucerne_Festival","https://lucerneresidence.ch/en/posts/annual-festivals-in-lucerne-switzerland","https://tripbytrip.org/2024/07/11/switzerland-introducing-lucerne/"],"method":"web"},"sources":["web"]},{"name":"Fasnacht, Lucerne's carnival","type":"festival","detail":"In the days before Lent the city erupts with masked parades and Guggenmusik brass bands from dawn; Switzerland's wildest carnival week.","season":[2,3],"link":"https://www.luzern.com/en/highlights/carnival-in-lucerne","evidence":{"n_sources":3,"of":21,"urls":["https://www.luzern.com/en/highlights/carnival-in-lucerne","https://lucerneresidence.ch/en/posts/annual-festivals-in-lucerne-switzerland","https://tripbytrip.org/2024/07/11/switzerland-introducing-lucerne/"],"method":"web"},"sources":["web"]},{"name":"Haslihorn","type":"activity","detail":"Berg und prähistorische Siedlung / mittelalterliche Burg in Hergiswil im Kanton Nidwalden, Schweiz","sources":["heritage","osm","wikidata","wikipedia"],"evidence":{"method":"open","n_sources":4,"sources":["heritage","osm","wikidata","wikipedia"]}},{"name":"Klimsenhorn","type":"activity","detail":"Gipfel in den Zentralschweizer Voralpen","sources":["osm","wikidata","wikipedia"],"evidence":{"method":"open","n_sources":3,"sources":["osm","wikidata","wikipedia"]}},{"name":"Glacier garden","type":"activity","sources":["heritage","osm","wikivoyage"],"evidence":{"method":"open","n_sources":3,"sources":["heritage","osm","wikivoyage"]}}],"nearby":{"lakes":[{"layer":"lakes","cc":"CH","id":"ch-lake-lucerne-Q14381","name":"Lake Lucerne","km":7.8,"bearing":"SE","lat":47.0194,"lon":8.4011,"tier":3,"score":9.2,"thumb":"https://upload.wikimedia.org/wikipedia/commons/thumb/9/90/20240906.Lake_Lucerne.-011.jpg/500px-20240906.Lake_Lucerne.-011.jpg","water":"Excellent","thumb_ok_print":false},{"layer":"lakes","cc":"CH","id":"ch-urne