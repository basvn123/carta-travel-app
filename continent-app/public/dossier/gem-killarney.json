:"Lake","lat":52.04167,"lon":-9.55,"dist_km":3.7,"rank_score":6.85,"resolved_by":"catalogue","image":{"url":"https://commons.wikimedia.org/wiki/Special:FilePath/Loch%20L%C3%A9in%20i%20gContae%20Chiarra%C3%AD%2C%20%C3%89ire.jpg?width=960","author":"Ériugena","licence":"CC BY 4.0","licence_url":"https://creativecommons.org/licenses/by/4.0","page":"https://commons.wikimedia.org/wiki/File:Loch_L%C3%A9in_i_gContae_Chiarra%C3%AD,_%C3%89ire.jpg","w":3000,"h":4000,"ok_print":true}}],"do":[{"name":"Walk the national park trails","type":"trail","detail":"Marked routes run through oak and yew woods and around Muckross Lake, from easy loops to the Old Kenmare Road across open bog.","season":[3,4,5,6,7,8,9,10],"evidence":{"n_sources":9,"of":13,"urls":["https://www.nationalparks.ie/killarney/","https://en.wikivoyage.org/wiki/Killarney","https://evendo.com/locations/ireland/killarney","https://www.killarney.ie/"],"method":"web"},"sources":["web"]},{"name":"Muckross House, gardens and working farms","type":"experience","detail":"A Victorian mansion with gardens, plus farms run as they were in the 1920s and craft workshops for pottery, weaving and bookbinding.","link":"https://www.muckross-house.ie/","evidence":{"n_sources":9,"of":13,"urls":["https://www.muckross-house.ie/","https://en.wikivoyage.org/wiki/Killarney","https://evendo.com/locations/ireland/killarney","https://www.nationalparks.ie/killarney/"],"method":"web"},"sources":["web"]},{"name":"Ross Castle on Lough Leane","type":"experience","detail":"A 15th century tower house two kilometres from town, shown by small guided tours, with lakeshore paths and bike tracks around it.","season":[3,4,5,6,7,8,9,10,11],"link":"https://heritageireland.ie/places-to-visit/ross-castle/","evidence":{"n_sources":8,"of":13,"urls":["https://heritageireland.ie/places-to-visit/ross-castle/","https://en.wikivoyage.org/wiki/Killarney","https://evendo.com/locations/ireland/killarney","https://www.nationalparks.ie/killarney/"],"method":"web"},"sources":["web"]},{"name":"Boat across the lakes, walking the Gap of Dunloe","type":"activity","detail":"The classic day pairs a hike through the mountain gap with an open boat back through the three lakes, landing at Ross Castle.","season":[4,5,6,7,8,9,10],"link":"https://gapofdunloetours.com/","evidence":{"n_sources":7,"of":13,"urls":["https://gapofdunloetours.com/","https://en.wikivoyage.org/wiki/Killarney","https://evendo.com/locations/ireland/killarney"],"method":"web"},"sources":["web"]},{"name":"Ride a jaunting car","type":"activity","detail":"Horse drawn traps seating four run from town out to Ross Castle and Muckross, with the driver keeping up a running commentary.","evidence":{"n_sources":6,"of":13,"urls":["https://en.wikivoyage.org/wiki/Killarney","https://evendo.com/locations/ireland/killarney","https://www.nationalparks.ie/killarney/"],"method":"web"},"sources":["web"]},{"name":"Torc Waterfall and the Cardiac Steps","type":"trail","detail":"The fall is five minutes from the car park. Behind it a long stair climbs to a viewpoint over the lakes for those who keep going.","evidence":{"n_sources":6,"of":13,"urls":["https://en.wikivoyage.org/wiki/Killarney","https://www.nationalparks.ie/killarney/","https://evendo.com/locations/ireland/killarney"],"method":"web"},"sources":["web"]},{"name":"Hire a bike for the park roads","type":"activity","detail":"Rental shops sit in town and the traffic free lanes to Ross Castle and Muckross make an easy half day on two wheels.","season":[4,5,6,7,8,9],"evidence":{"n_sources":5,"of":13,"urls":["https://en.wikivoyage.org/wiki/Killarney","https://www.killarney.ie/","https://heritageireland.ie/places-to-visit/ross-castle/"],"method":"web"},"sources":["web"]},{"name":"Muckross Abbey","type":"activity","detail":"A Franciscan friary of 1448, roofless but standing, with a yew tree filling the whole cloister.","evidence":{"n_sources":5,"of":13,"urls":["https://killarney.ie/things-to-do/","https://wanderingcarol.com/killarney-national-park/","https://outboundlynx.com/things-to-do-in-killarney-national-park/"],"method":"web"},"sources":["web"]},{"name":"Drive the Ring of Kerry","type":"activity","detail":"A 179 km loop of the Iveragh peninsula, the classic Irish coast drive, and Killarney is where it starts and ends.","evidence":{"n_sources":5,"of":13,"urls":["https://www.bontraveler.com/killarney-ireland/","https://www.viator.com/Killarney/d911","https://www.muckrosspark.com/visit-killarney/"],"method":"web"},"sources":["web"]},{"name":"Killarney Races","type":"festival","detail":"The town racecourse runs meetings from spring to autumn, mixing flat cards with jumps, and the pubs fill up on race evenings.","season":[5,6,7,8,9,10],"evidence":{"n_sources":3,"of":13,"urls":["https://www.killarney.ie/","https://en.wikivoyage.org/wiki/Killarney","https://evendo.com/locations/ireland/killarney"],"method":"web"},"sources":["web"]}],"nearby":{"lakes":[{"layer":"lakes","cc":"IE","id":"ie-lough-leane-Q6686132","name":"Lough Leane","km":3.7,"bearing":"SW","lat":52.04167,"lon":-9.55,"tier":1,"score":7.4,"thumb":"https://upload.wikimedia.org/wikipedia/commons/thumb/2/20/Killarney_Lough-Leane.jpg/500px-Killarney_Lough-Leane.jpg","thumb_ok_print":true}],"trails":[{"layer":"trails","cc":"IE","id":"310799","name":"Killarney in a day","km":3.2,"bearing":"S","lat":52.03151,"lon":-9.51317,"tier":2,"km_len":12.1,"duration_min":456}],"mountains":[{"layer":"mountains","cc":"IE","id":"ie-carrauntoohil-Q503368","name":"Carrauntoohil","km":17.7,"bearing":"W","lat":51.99889,"lon":-9.74278,"tier":1,"score":7.2,"thumb":"https://upload.wikimedia.org/wikipedia/commons/a/ad/Carrauntoohil_Group_from_Cruach_Mhor.jpg","thumb_ok_print":true},{"layer":"mountains","cc":"IE","id":"ie-torc-mountain-Q3777099","name":"Torc Mountain","km":6.7,"bearing":"S","lat":52.0,"lon":-9.51667,"tier":0,"score":5.3,"thumb":"https://upload.wikimedia.org/wikipedia/commons/thumb/f/fe/Torc_Mountain_Viewed_From_Killarney_National_Park.jpg/500px-Torc_Mountain