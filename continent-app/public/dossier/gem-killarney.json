oss Abbey are inside Killarney National Park, with Lough Leane and MacGillycuddy's Reeks beyond. June to August is the season.","short_src":"rewrite","facts":{"population":14504,"visit_h":3.9}},"highlights":[{"id":"hl-killarney-national-park","name":"Killarney National Park","kind":"National park","lat":52.02099,"lon":-9.50664,"dist_km":4.3,"rank_score":9.79,"resolved_by":"catalogue","image":{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/9/9c/Lakes_of_Killarney.JPG/960px-Lakes_of_Killarney.JPG","licence":"Public domain","page":"https://commons.wikimedia.org/wiki/File:Lakes_of_Killarney.JPG","w":1600,"h":1200,"ok_print":true}},{"id":"hl-macgillycuddy-s-reeks","name":"MacGillycuddy's Reeks","kind":"Peak","lat":52.01,"lon":-9.7,"dist_km":14.5,"rank_score":9.63,"resolved_by":"catalogue","image":{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/2/24/MacGuillycuddy%27s_Reeks.jpg/960px-MacGuillycuddy%27s_Reeks.jpg","author":"Matpib","licence":"CC BY-SA 3.0","licence_url":"http://creativecommons.org/licenses/by-sa/3.0/","page":"https://commons.wikimedia.org/wiki/File:MacGuillycuddy's_Reeks.jpg","w":1752,"h":1134,"ok_print":true}},{"id":"hl-ross-castle","name":"Ross Castle","kind":"Castle","lat":52.041,"lon":-9.531,"dist_km":2.8,"rank_score":8.83,"resolved_by":"catalogue","image":{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/2/29/Ross_Castle_on_Lough_Leane_%2815242590587%29.jpg/960px-Ross_Castle_on_Lough_Leane_%2815242590587%29.jpg","author":"Dumphasizer","licence":"CC BY-SA 2.0","licence_url":"https://creativecommons.org/licenses/by-sa/2.0","page":"https://commons.wikimedia.org/wiki/File:Ross_Castle_on_Lough_Leane_(15242590587).jpg","ok_print":true}},{"id":"hl-muckross-house","name":"Muckross House","kind":"Museum","lat":52.01778,"lon":-9.50167,"dist_km":4.7,"rank_score":8.48,"resolved_by":"catalogue","image":{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/b/b5/Eastern_Facade.jpg/960px-Eastern_Facade.jpg","author":"Emmett