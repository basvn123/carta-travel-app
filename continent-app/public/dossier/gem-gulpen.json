 Dutch, who use is as a starting point for day trips to the many sights in the region. Nevertheless, Gulpen is a pleasant place with some worthwhile sights and a number of nice bars and restaurants.","grounding":[{"source":"wikivoyage","title":"Gulpen","url":"https://en.wikivoyage.org/wiki/Gulpen","licence":"CC BY-SA 4.0"}],"facts":{"population":3560,"visit_h":3.6}},"highlights":[{"id":"hl-klimmen-ransdaal","name":"Klimmen-Ransdaal","kind":"Castle","lat":50.86626,"lon":5.89017,"dist_km":5.6,"sig":2.379,"rank_score":10.5,"resolved_by":"retyped","fact":"Municipality in Limburg, Netherlands","image":{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/3/38/Furenthela.JPG/500px-Furenthela.JPG?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail","author":"Doc Brown (Real name available, contact me please)","licence":"CC BY-SA 3.0","licence_url":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Furenthela.JPG","ok_print":true},"wikipedia":"https://en.wikipedia.org/wiki/Voerendaal","heritage":true,"merged_from":["Voerendaal"]},{"id":"hl-fort-eben-emael","name":"Fort Eben-Emael","kind":"Museum","lat":50.79722,"lon":5.68083,"dist_km":14.8,"rank_score":9.74,"resolved_by":"catalogue","image":{"url":"https://commons.wikimedia.org/wiki/Special:FilePath/Fort%20Eben-Emael%20Blok%20I%207-06-2024%2015-07-54.jpg?width=960","author":"Paul Hermans","licence":"CC BY-SA 4.0","licence_url":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Fort_Eben-Emael_Blok_I_7-06-2024_15-07-54.jpg","w":5138,"h":2894,"ok_print":true}},{"id":"hl-schin-op-geul","name":"Schin op Geul","kind":"Castle","lat":50.85598,"lon":5.87147,"dist_km":4.6,"sig":2.379,"rank_score":8.7,"resolved_by":"retyped","fact":"Village in Limburg, Netherlands","image":{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/3/3a/Schin_op_geul_St._Mauritius.JPG/500px-Schin_op_geul_St._Mauritius.JPG?utm_source=en.w