":"Poznan is anchored by the Archcathedral Basilica of St Peter and St Paul and the walls of Poznan Fortress. Lake Malta and Lubon fill a long day near seventeen hours across the metro area. May through September suits Wielkopolski Park Narodowy best.","short_src":"rewrite","facts":{"population":536151,"visit_h":13.8}},"highlights":[{"id":"hl-archcathedral-basilica-of-st-peter-and-st-paul","name":"Archcathedral Basilica of St. Peter and St. Paul","kind":"Cathedral","lat":52.41139,"lon":16.94778,"dist_km":1.0,"rank_score":9.34,"resolved_by":"catalogue"},{"id":"hl-lake-malta","name":"Lake Malta","kind":"Lake","lat":52.4025,"lon":16.97083,"dist_km":2.6,"rank_score":9.2,"resolved_by":"catalogue"},{"id":"hl-national-museum-in-poznan","name":"National Museum in Poznań","kind":"Museum","lat":52.40865,"lon":16.9289,"dist_km":0.4,"rank_score":9.11,"resolved_by":"catalogue","image":{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/3/3a/Muzeum_Narodow_Galeria_Malarstwa_Pozna%C5%84_RB1.JPG/960px-Muzeum_Narodow_Galeria_Malarstwa_Pozna%C5%84_RB1.JPG","author":"Radomil talk","licence":"CC BY-SA 3.0","licence_url":"http://creativecommons.org/licenses/by-sa/3.0/","page":"https://commons.wikimedia.org/wiki/File:Muzeum_Narodow_Galeria_Malarstwa_Pozna%C5%84_RB1.JPG","w":1280,"h":960,"ok_print":true}},{"id":"hl-poznan-fortress","name":"Poznań Fortress","kind":"Castle","lat":52.4219,"lon":16.9352,"dist_km":1.5,"rank_score":8.07,"resolved_by":"catalogue"}],"do":[{"name":"Termy Maltańskie","type":"activity","sources":["wikidata","wikivoyage"],"evidence":{"method":"open","n_sources":2,"sources":["wikidata","wikivoyage"],"curated":"wikivoyage_do"}},{"name":"Nowe Zoo","type":"activity","sources":["wikidata","wikivoyage"],"evidence":{"method":"open","n_sources":2,"sources":["wikidata","wikivoyage"],"curated":"wikivoyage_do"}},{"name":"Park Railway Maltanka","type":"activity","sources":["wikidata","wikivoyage"],"evidence":{"method":"open","n_sources":2,"sources":["wikidata","wikivoya