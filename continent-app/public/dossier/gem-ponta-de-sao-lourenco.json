ponta-de-sao-lourenco-hike/"],"method":"web"},"sources":["web"]},{"name":"Swim at Cais do Sardinha","type":"swim","detail":"The far end of the walk, and the only sheltered water on the peninsula. The Casa do Sardinha cafe sits behind it, which is the only shade out there too.","season":[6,7,8,9],"evidence":{"n_sources":5,"of":16,"urls":["https://www.getyourguide.com/madeira-l67/quinta-do-lorde-ponta-de-sao-lourenco-water-taxi-t392802/","https://somewheregood.com/ponta-de-sao-lourenco-boat-tour/","https://www.myguide-madeira.com/things-to-do/madeira-full-day-of-activities-in-ponta-de-sao-lourenco"],"method":"web"},"sources":["web"]},{"name":"Kayak and snorkel the bay","type":"activity","detail":"Sea kayak trips run the same coast at water level, with snorkelling over the rock in the shelter of the bay.","season":[5,6,7,8,9],"evidence":{"n_sources":4,"of":16,"urls":["https://www.checkyeti.com/en/d/2666/21304","https://eversoulmadeira.com/experiences/kayaking-at-ponta-de-sao-lourenco/","https://madeiraseaemotions.com/tours/day-pack-ponta-de-sao-lourenco/"],"method":"web"},"sources":["web"]},{"name":"Pico do Facho","type":"activity","sources":["heritage","osm"],"evidence":{"method":"open","n_sources":2,"sources":["heritage","osm"]}},{"name":"Ilhéu do Farol","type":"activity","detail":"5 km away","sources":["commons","wikidata"],"evidence":{"method":"open","n_sources":2,"sources":["commons","wikidata"]}},{"name":"Garajau","type":"activity","detail":"18 km away","sources":["commons","wikidata"],"evidence":{"method":"open","n_sources":2,"sources":["commons","wikidata"]}},{"name":"Convento de Santa Clara","type":"activity","detail":"22 km away","sources":["commons","wikidata"],"evidence":{"method":"open","n_sources":2,"sources":["commons","wikidata"]}},{"name":"Achada do Teixeira","type":"activity","detail":"20 km away","sources":["commons","wikidata"],"evidence":{"method":"open","n_sources":2,"sources":["commons","wikidata"]}}],"nearby":{"beaches":[{"layer":"beaches","cc":