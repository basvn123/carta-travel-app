":["web"]},{"name":"Boat trip on the Como basin","type":"activity","detail":"See the lake the way it is meant to be seen: an hour on the water calling at Cernobbio, Moltrasio and Torno, villas sliding past.","evidence":{"n_sources":4,"of":25,"urls":["https://www.ontheluce.com/things-to-do-como-italy/","https://www.carnets-voyages.org/en/14-best-things-to-do-in-lake-como/","https://www.trvbox.com/best-things-to-do-in-lake-como/","https://www.tripadvisor.com/Attractions-g187833-Activities-Lake_Como_Lombardy.html"],"method":"web"},"sources":["web"]},{"name":"Funicular to Brunate and the Volta lighthouse","type":"trail","detail":"Take the funicular 700 m above Como, walk to the Faro Voltiano and loop the balcony trails for lake and Alp views; 2 to 4 hours.","evidence":{"n_sources":4,"of":25,"urls":["https://www.komoot.com/guide/560153/hiking-around-brunate","https://lakecomoforyou.com/the-best-panoramic-views-on-lake-como/","https://www.m24o.net/product/hiking-como-brunate-torno/","https://lakecomoexplorer.com/lake-como-hiking-outdoor-activities-guide/"],"method":"web"},"sources":["web"]},{"name":"Greenway del Lago walk","type":"trail","detail":"Gentle 10 km path from Colonno to Cadenabbia on the old Roman shore road, threading medieval villages with the lake always in view.","evidence":{"n_sources":3,"of":25,"urls":["https://greatruns.com/lake-como-greenway-del-lago-di-como/","https://lakecomoexplorer.com/lake-como-hiking-outdoor-activities-guide/","https://www.explorelakecomo.com/cat/hikes-and-walks"],"method":"web"},"sources":["web"]},{"name":"Festival of San Giovanni","type":"festival","detail":"Como's beloved June feast: fireworks reflected across the lake, processions, music and food stalls along the waterfront.","season":[6],"evidence":{"n_sources":3,"of":25,"urls":["https://thingstodoincomo.com/events/","https://adventurebackpack.com/como-events","https://comolake.today/the-most-anticipated-events-on-lake-como/"],"method":"web"},"sources":["web"]},{"name":"Summe