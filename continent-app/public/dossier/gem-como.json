PG/500px-Lago_di_Piano.JPG","caption":"Lago di Piano","author":"Benreis","licence":"CC BY-SA 3.0","licence_url":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Lago_di_Piano.JPG","w":3456,"h":2304,"ok_print":true},{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/a/aa/-i---i-_%2850888107337%29.jpg/960px--i---i-_%2850888107337%29.jpg","thumb":"https://upload.wikimedia.org/wikipedia/commons/thumb/a/aa/-i---i-_%2850888107337%29.jpg/500px--i---i-_%2850888107337%29.jpg","caption":"Lido di Agno","author":"Thomas Woodtli from Zürich, Switzerland","licence":"CC BY-SA 2.0","licence_url":"https://creativecommons.org/licenses/by-sa/2.0","page":"https://commons.wikimedia.org/wiki/File:-i---i-_(50888107337).jpg","w":4032,"h":3024,"ok_print":true},{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/2/26/Caslano_-_Magliaso_-_Agno_%282%29.jpg/960px-Caslano_-_Magliaso_-_Agno_%282%29.jpg","thumb":"https://upload.wikimedia.org/wikipedia/commons/thumb/2/26/Caslano_-_Magliaso_-_Agno_%282%29.jpg/500px-Caslano_-_Magliaso_-_Agno_%282%29.jpg","caption":"Caslano","author":"Beat Ruest","licence":"CC BY 4.0","licence_url":"https://creativecommons.org/licenses/by/4.0","page":"https://commons.wikimedia.org/wiki/File:Caslano_-_Magliaso_-_Agno_(2).jpg","w":4000,"h":2250,"ok_print":true},{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/d/de/Astano_Laghetto2.jpg/960px-Astano_Laghetto2.jpg","thumb":"https://upload.wikimedia.org/wikipedia/commons/thumb/d/de/Astano_Laghetto2.jpg/500px-Astano_Laghetto2.jpg","caption":"Laghetto Di Astano","author":"Adrian Michael","licence":"CC BY-SA 3.0","licence_url":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Astano_Laghetto2.jpg","w":3564,"h":2716,"ok_print":true}],"intro":{"lead":"Glamorous alpine lake, villas and slopes","body":"Lake Como (Lago di Como; also called: Lario) is in the provinces of Como and Lecco in Lombardy, Northern Italy. It is part of the Italian Lake District. It has been popular with visitors since the early 20th century for its combination of fresh air, water, mountains and good weather.","grounding":[{"source":"wikivoyage","title":"Lake Como","url":"https://en.wikivoyage.org/wiki/Lake_Como","licence":"CC BY-SA 4.0"}],"short":"Lake Como is a long alpine lake in Lombardy, Italy, ringed by villages and old villas. Bellagio and Varenna face each other across the water, and Villa Carlotta is the garden to see. Public transport is poor, so a boat helps.","short_src":"rewrite","facts":{"population":2823,"visit_h":5.1}},"do":[{"name":"Ferry hop the mid lake triangle","type":"activity","detail":"Ride the boats between Bellagio, Varenna and Menaggio; crossings take about ten minutes and run every 20 to 40 minutes all day.","link":"https://www.navigazionelaghi.it/en/tickets-and-timetables-lake-como/","evidence":{"n_sources":7,"of":25,"urls":["https://www.navigazionelaghi.it/en/tickets-and-timetables-lake-como/","https://lakecomotravel.com/boat-tours-ferry-lake-como/","https://lionsinthepiazza.com/lake-como-ferries/","https://lakecomoexplorer.com/lake-como-ferry-your-guide-to-getting-around-lake-como/","https://comolake.today/lake-como-ferry-boats-timetable/"],"method":"web"},"sources":["web"]},{"name":"Villa gardens: Carlotta, Melzi and Monastero","type":"experience","detail":"Lakefront botanical gardens at Villa Carlotta in Tremezzo, Villa Melzi in Bellagio and Villa Monastero in Varenna, terraces right on the water.","season":[4,5,6,7,8,9,10],"link":"https://www.getyourguide.com/milan-l139/milan-lake-como-villages-day-trip-w-train-ferry-tickets-t475754/","evidence":{"n_sources":5,"of":25,"urls":["https://www.getyourguide.com/milan-l139/milan-lake-como-villages-day-trip-w-train-ferry-tickets-t475754/","https://www.bellagiolakecomo.com/en/walking-tours-around-bellagio/varenna-the-queen-of-the-eastern-shore","https://bucketlistbums.com/single-post/lakecomo/","https://www.carnets-voyages.org/en/14-best-things-to-do-in-lake-como/"],"method":"web"},"sources":["web"]},{"name":"Boat trip on the Como basin","type":"activity","detail":"See the lake the way it is meant to be seen: an hour on the water calling at Cernobbio, Moltrasio and Torno, villas sliding past.","evidence":{"n_sources":4,"of":25,"urls":["https://www.ontheluce.com/things-to-do-como-italy/","https://www.carnets-voyages.org/en/14-best-things-to-do-in-lake-como/","https://www.trvbox.com/best-things-to-do-in-lake-como/","https://www.tripadvisor.com/Attractions-g187833-Activities-Lake_Como_Lombardy.html"],"method":"web"},"sources":["web"]},{"name":"Funicular to Brunate and the Volta lighthouse","type":"trail","detail":"Take the funicular 700 m above Como, walk to the Faro Voltiano and loop the balcony trails for lake and Alp views; 2 to 4 hours.","evidence":{"n_sources":4,"of":25,"urls":["https://www.komoot.com/guide/560153/hiking-around-brunate","https://lakecomoforyou.com/the-best-panoramic-views-on-lake-como/","https://www.m24o.net/product/hiking-como-brunate-torno/","https://lakecomoexplorer.com/lake-como-hiking-outdoor-activities-guide/"],"method":"web"},"sources":["web"]},{"name":"Greenway del Lago walk","type":"trail","detail":"Gentle 10 km path from Colonno to Cadenabbia on the old Roman shore road, threading medieval villages with the lake always in view.","evidence":{"n_sources":3,"of":25,"urls":["https://greatruns.com/lake-como-greenway-del-lago-di-como/","https://lakecomoexplorer.com/lake-como-hiking-outdoor-activities-guide/","https://www.explorelakecomo.com/cat/hikes-and-walks"],"method":"web"},"sources":["web"]},{"name":"Festival of San Giovanni","type":"festival","detail":"Como's beloved June feast: fireworks reflected across the lake, processions, music and food stalls along the waterfront.","season":[6],"evidence":{"n_sources":3,"of":25,"urls":["https://thingstodoincomo.com/events/","https://adventurebackpack.com/como-events","https://comolake.today/the-most-anticipated-events-on-lake-como/"],"method":"web"},"sources":["web"]},{"name":"Summer music: Lake Como Festival and Nameless","type":"festival","detail":"Classical concerts in villas since 2006, guitar nights in Menaggio, and the big Nameless electronic weekend pull crowds each summer.","season":[6,7,8],"evidence":{"n_sources":3,"of":25,"urls":["https://royalmenaggio.com/music-lake-como","https://lakecomotraveltips.com/lake-como-2025-events-youll-love-this-summer/","https://comolake.today/the-most-anticipated-events-on-lake-como/"],"method":"web"},"sources":["web"]},{"name":"Concorso d'Eleganza Villa d'Este","type":"festival","detail":"Cernobbio's spring parade of vintage and concept cars on the Villa d'Este lawns, the lake's most glamorous weekend.","season":[5],"evidence":{"n_sources":3,"of":25,"urls":["https://www.comer-see-italien.com/en/lake-como-abc/events-festivals-and-culture-on-lake-como_k12/","https://www.casarina.com/lake-como-holiday-homes/lakecomo-events.php","https://comolake.today/the-most-anticipated-events-on-lake-como/"],"method":"web"},"sources":["web"]},{"name":"Lake Lugano","type":"swim","detail":"20 km away, water rated Excellent","ref":{"layer":"lakes","cc":"CH","id":"ch-lake-lugano-Q14418"},"sources":["eea","layer"],"evidence":{"method":"open","n_sources":2,"sources":["eea","layer"]}},{"name":"Lake of Pusiano","type":"swim","detail":"22 km away, water rated Excellent","ref":{"layer":"lakes","cc":"IT","id":"it-lake-of-pusiano-Q63177"},"sources":["eea","layer"],"evidence":{"method":"open","n_sources":2,"sources":["eea","layer"]}}],"nearby":{"beaches":[{"layer":"beaches","cc":"CH","id":"ch-lido-di-agno-way294814846","name":"Lido di Agno","km":27.7,"bearing":"W","lat":45.99234,"lon":8.89918,"tier":1,"score":6.5,"thumb":"https://upload.wikimedia.org/wikipedia/commons/thumb/a/aa/-i---i-_%2850888107337%29.jpg/500px--i---i-_%2850888107337%29.jpg","water":"Excellent","thumb_ok_print":true},{"layer":"beaches","cc":"CH","id":"ch-caslano-way372690338","name":"Caslano