wikimedia.org/wiki/File:Brugnato-cattedrale-facciata.jpg","w":3264,"h":2448,"ok_print":true}}],"do":[{"name":"Sentiero Azzurro village-to-village hike","type":"trail","detail":"Coastal Blue Trail links all five villages over about 12 km; plan 5 to 6 hours plus stops, and buy the park trekking card for the paid legs.","season":[4,5,6,9,10],"link":"https://www.parconazionale5terre.it/page.php?id=157","evidence":{"n_sources":18,"of":45,"urls":["https://www.earthtrekkers.com/hiking-cinque-terre-italy/","https://www.twowanderingsoles.com/blog/blue-trail-cinque-terre-hike","https://www.parconazionale5terre.it/Esentieri-outdoor.php"],"method":"web"},"sources":["web"]},{"name":"Coastal boat tour of the five villages","type":"activity","detail":"Seeing the pastel houses stacked on the cliffs from the water is the classic reverse view; sunset departures add wine and swim stops.","season":[5,6,7,8,9],"link":"https://www.cinqueterreadventure.com/","evidence":{"n_sources":7,"of":45,"urls":["https://www.cinqueterreadventure.com/","https://cinqueterredalmare.com/en/boat-kayak-rentals/","https://www.migratingmiss.com/things-to-do-cinque-terre-italy/"],"method":"web"},"sources":["web"]},{"name":"Kayak to hidden coves","type":"activity","detail":"Rentals and guided paddles leave from Riomaggiore, Manarola, Vernazza and Monterosso, reaching swim coves the trails never touch.","season":[5,6,7,8,9],"link":"https://cinqueterredalmare.com/en/boat-kayak-rentals/","evidence":{"n_sources":7,"of":45,"urls":["https://cinqueterredalmare.com/en/boat-kayak-rentals/","https://www.theadventuremanual.com/kayaking-cinque-terre","https://cinqueterre-travel.com/tours/kayak/"],"method":"web"},"sources":["web"]},{"name":"Wine tasting in the terraced vineyards","type":"experience","detail":"Hand-worked terraces above the sea produce crisp whites and the sweet Sciacchetra; small cellars pour tastings with vineyard views.","evidence":{"n_sources":6,"of":45,"urls":["https://www.winalist.com/blog/italy-wine-region/liguria/cinque-terre-things-to-do","https://www.cinqueterre.eu.com/en/cinque-terre-food-and-wine","https://www.ricksteves.com/watch-read-listen/read/articles/cinque-terre-cuisine-101"],"method":"web"},"sources":["web"]},{"name":"Pesto making and Ligurian food","type":"experience","detail":"Pesto was born in Liguria; classes teach the mortar method, and bakeries sell focaccia, farinata and Monterosso anchovies to try.","evidence":{"n_sources":5,"of":45,"urls":["https://www.ricksteves.com/watch-read-listen/read/articles/cinque-terre-cuisine-101","https://www.followingmycompass.com/8-foods-to-try-in-the-cinque-terre/","https://www.deliciousitaly.com/liguria-food/traditional-dishes-of-the-cinque-terre"],"method":"web"},"sources":["web"]},{"name":"Swim from the coves and beaches","type":"swim","detail":"Monterosso has the only proper beach; elsewhere locals swim off rocks and small coves reached by unmarked paths down from the villages.","season":[6,7,8,9],"evidence":{"n_sources":5,"of":45,"urls":["https://travelswithingrid.com/italy/15-best-things-to-do-in-cinque-terre","https://www.machupicchu.org/cinque-terre-hidden-gems-guide-secret-spots-lesser-known-treasures.htm","https://www.theadventuremanual.com/kayaking-cinque-terre"],"method":"web"},"sources":["web"]},{"name":"Village festivals: lemons and fried anchovies","type":"festival","detail":"Monterosso holds a lemon feast in mid May and a fried anchovy festival in June; Corpus Domini brings a flower-petal carpet procession.","season":[5,6],"evidence":{"n_sources":4,"of":45,"urls":["https://www.lecinqueterre.org/eng/feste.php","https://cinqueterreriviera.com/events/","https://www.arbaspaa.com/events-culture/2024-summer-events-in-the-cinque-terre-gulf-of-la-spezia-val-di-vara-lunigiana"],"method":"web"},"sources":["web"]}],"nearby":{"beaches":[{"layer":"beaches","cc":"IT","id":"it-spiaggia-di-fegina-Q113366179","name":"spiaggia di Fegina","km":5.2,"bearing":"W","lat":44.14559,"lon":9.64976,"tier":1,"score":7.5,"t