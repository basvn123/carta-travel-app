esa-monte-perdido-national-park/"],"method":"web"},"sources":["web"]},{"name":"Monte Perdido via Refugio de Goriz","type":"activity","detail":"Overnight at the Goriz hut, then climb the third highest Pyrenean summit and its small glacier; experienced parties only.","season":[6,7,8,9],"evidence":{"n_sources":5,"of":12,"urls":["https://www.myglobalviewpoint.com/things-to-do-in-ordesa-monte-perdido-national-park/","https://rutica41.com/ordesa-and-monte-perdido-national-park/","https://www.spain.info/en/nature/ordesa-monte-perdido-national-park/"],"method":"web"},"sources":["web"]},{"name":"Faja de Pelay balcony trail","type":"trail","detail":"Demanding ledge route high on the Ordesa valley wall; loop it with the floor path for the best canyon panoramas.","season":[6,7,8,9],"link":"https://www.alltrails.com/parks/spain/huesca/parque-nacional-de-ordesa-y-monte-perdido","evidence":{"n_sources":5,"of":12,"urls":["https://www.myglobalviewpoint.com/things-to-do-in-ordesa-monte-perdido-national-park/","https://rutica41.com/ordesa-and-monte-perdido-national-park/","https://www.alltrails.com/parks/spain/huesca/parque-nacional-de-ordesa-y-monte-perdido"],"method":"web"},"sources":["web"]},{"name":"Watch for bearded vultures and chamois","type":"experience","detail":"The park is a stronghold for the lammergeier; bring binoculars for chamois and raptors above the Escuain side gorges.","evidence":{"n_sources":4,"of":12,"urls":["https://www.myglobalviewpoint.com/things-to-do-in-ordesa-monte-perdido-national-park/","https://www.spain.info/en/nature/ordesa-monte-perdido-national-park/","https://www.callingforthewild.com/guide-to-visiting-ordesa-y-monte-perdido-national-park/"],"method":"web"},"sources":["web"]},{"name":"Pic de Marboré","type":"activity","detail":"Summit in the Pyrenees on the Franco-Spanish border","sources":["osm","wikidata","wikipedia"],"evidence":{"method":"open","n_sources":3,"sources":["osm","wikidata","wikipedia"]}},{"name":"La Brèche de Roland","type":"activity