,6,7,8,9,10],"link":"https://www.spain.info/en/nature/ordesa-monte-perdido-national-park/","evidence":{"n_sources":9,"of":12,"urls":["https://www.myglobalviewpoint.com/things-to-do-in-ordesa-monte-perdido-national-park/","https://www.spain.info/en/nature/ordesa-monte-perdido-national-park/","https://rutica41.com/ordesa-and-monte-perdido-national-park/"],"method":"web"},"sources":["web"]},{"name":"Base in Torla and ride the Pradera shuttle","type":"experience","detail":"Cars are banned from the valley road in season, so you park at Torla and take the shuttle to the Pradera. The park visitor centre is in the village too.","evidence":{"n_sources":7,"of":12,"urls":["https://rutica41.com/ordesa-and-monte-perdido-national-park/","https://www.callingforthewild.com/guide-to-visiting-ordesa-y-monte-perdido-national-park/","https://www.spain.info/en/nature/ordesa-monte-perdido-national-park/"],"method":"web"},"sources":["web"]},{"name":"Anisclo Canyon","type":"trail","detail":"Deep limestone slot cut by the Bellos river on the park's quieter south side; a 3 to 4 hour circuit threads the gorge.","evidence":{"n_sources":5,"of":12,"urls":["https://www.myglobalviewpoint.com/things-to-do-in-ordesa-monte-perdido-national-park/","https://www.callingforthewild.com/guide-to-visiting-ordesa-y-monte-perdido-national-park/","https://www.spain.info/en/nature/ordesa-monte-perdido-national-park/"],"method":"web"},"sources":["web"]},{"name":"Monte Perdido via Refugio de Goriz","type":"activity","detail":"Overnight at the Goriz hut, then climb the third highest Pyrenean summit and its small glacier; experienced parties only.","season":[6,7,8,9],"evidence":{"n_sources":5,"of":12,"urls":["https://www.myglobalviewpoint.com/things-to-do-in-ordesa-monte-perdido-national-park/","https://rutica41.com/ordesa-and-monte-perdido-national-park/","https://www.spain.info/en/nature/ordesa-monte-perdido-national-park/"],"method":"web"},"sources":["web"]},{"name":"Faja de Pelay balcony trail","type":"trail","