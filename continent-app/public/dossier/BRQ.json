mporary South Moravian region.","grounding":[{"source":"wikivoyage","title":"Brno","url":"https://en.wikivoyage.org/wiki/Brno","licence":"CC BY-SA 4.0"}],"short":"Brno is a city in Czechia where modern and historic sit side by side. Spilberk Castle holds the hill, Vila Tugendhat draws architecture pilgrims, and the Museum of Romani Culture is rare anywhere. Its seventeen hours suit May through September.","short_src":"rewrite","facts":{"population":379466,"visit_h":16.8}},"highlights":[{"id":"hl-spilberk-castle","name":"Špilberk Castle","kind":"Castle","lat":49.1941,"lon":16.60069,"dist_km":0.5,"sig":2.525,"rank_score":11.36,"resolved_by":"catalogue","fact":"Czech fortress","image":{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/3/3c/%C5%A0pilberk_%2802%29.jpg/960px-%C5%A0pilberk_%2802%29.jpg","author":"Kirk","licence":"CC BY 2.5","licence_url":"https://creativecommons.org/licenses/by/2.5","page":"https://commons.wikimedia.org/wiki/File:%C5%A0pilberk_(02).jpg","ok_print":true},"wikipedia":"https://en.wikipedia.org/wiki/%C5%A0pilberk_Castle","heritage":true,"merged_from":["Špilberk"]},{"id":"hl-vila-tugendhat","name":"Vila Tugendhat","kind":"Museum","lat":49.20717,"lon":16.61606,"dist_km":1.5,"sig":2.987,"rank_score":10.76,"resolved_by":"catalogue","fact":"vila v Brně, památka UNESCO","image":{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/4/45/Villa_Tugendhat%2C_Brno.jpg/960px-Villa_Tugendhat%2C_Brno.jpg","author":"Thomas Ledl","licence":"CC BY 4.0","licence_url":"https://creativecommons.org/licenses/by/4.0","page":"https://commons.wikimedia.org/wiki/File:Villa_Tugendhat,_Brno.jpg","ok_print":true},"wikipedia":"https://cs.wikipedia.org/wiki/Vila_Tugendhat","heritage":true,"merged_from":["Villa Tugendhat"]},{"id":"hl-museum-of-romani-culture","name":"Museum of Romani Culture","kind":"Museum","lat":49.20053,"lon":16.62339,"dist_km":1.3,"sig":2.879,"rank_score":10.31,"resolved_by":"catalogue","fact":"Institution in Brno, Czech Republic","image