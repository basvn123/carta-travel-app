ravel.org/en/Colmar","https://www.visit.alsace/en/colmar/","https://en.wikipedia.org/wiki/Colmar","https://www.tourisme-colmar.com/en/","https://www.europeanbestdestinations.com/destinations/colmar/"],"method":"web"},"sources":["web"]},{"name":"Unterlinden Museum and the Isenheim altarpiece","type":"experience","detail":"A former convent holds Grunewald's altarpiece, opened out panel by panel, alongside Upper Rhine painting and a modern wing.","evidence":{"n_sources":7,"of":14,"urls":["https://en.wikivoyage.org/wiki/Colmar","https://www.visit.alsace/en/colmar/","https://en.wikipedia.org/wiki/Colmar","https://www.tourisme-colmar.com/en/","https://www.europeanbestdestinations.com/destinations/colmar/"],"method":"web"},"sources":["web"]},{"name":"Tasting along the Alsace wine route","type":"experience","detail":"Colmar sits mid route, so cellars in Riquewihr, Kaysersberg and Ribeauville are a short bus or bike ride for Riesling and Gewurztraminer.","season":[4,5,6,7,8,9,10],"evidence":{"n_sources":6,"of":14,"urls":["https://en.wikivoyage.org/wiki/Colmar","https://wikitravel.org/en/Colmar","https://en.wikipedia.org/wiki/Colmar","https://www.tourisme-colmar.com/en/","https://www.europeanbestdestinations.com/destinations/colmar/"],"method":"web"},"sources":["web"]},{"name":"Flat bottomed boat ride through Little Venice","type":"activity","detail":"A short punt along the Lauch from the fishmongers quay, passing back gardens and low bridges at water level.","season":[3,4,5,6,7,8,9,10,11],"link":"https://www.tourisme-colmar.com/en/","evidence":{"n_sources":6,"of":14,"urls":["https://wikitravel.org/en/Colmar","https://www.visit.alsace/en/colmar/","https://www.tourisme-colmar.com/en/"],"method":"web"},"sources":["web"]},{"name":"Bartholdi Museum, home of the Statue of Liberty sculptor","type":"experience","detail":"The sculptor was born in this house, and the rooms hold his models and drawings for the statue and for Colmar's own fountains.","evidence":{"n_sources":5,"of":14,"u