e and nearby beaches attract lots of day-trippers.","grounding":[{"source":"wikivoyage","title":"Hulst","url":"https://en.wikivoyage.org/wiki/Hulst","licence":"CC BY-SA 4.0"}],"short":"Hulst is a small fortified town in Zeeland, near the border with Belgium in the Netherlands. The Sint-Willibrordusbasiliek and De Stadsmolen fill about three hours, with Roosenberg Abbey close by; June to August is best for walking the ramparts.","short_src":"rewrite","facts":{"population":1405,"visit_h":3.4}},"highlights":[{"id":"hl-st-willibrord","name":"St. Willibrord","kind":"Church","lat":51.28061,"lon":4.05401,"dist_km":0.1,"rank_score":6.17,"resolved_by":"catalogue","image":{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/3/3b/HulstKerk2.JPG/960px-HulstKerk2.JPG","author":"Vitaly Volkov","licence":"CC BY 2.5","licence_url":"https://creativecommons.org/licenses/by/2.5","page":"https://commons.wikimedia.org/wiki/File:HulstKerk2.JPG","w":2288,"h":1712,"ok_print":true}},{"id":"hl-de-stadsmolen","name":"De Stadsmolen","kind":"Landmark","lat":51.28352,"lon":4.05302,"dist_km":0.4,"sig":2.518,"rank_score":5.8,"resolved_by":"retyped","fact":"windmolen in Hulst, Nederland","wikipedia":"https://nl.wikipedia.org/wiki/De_Stadsmolen","heritage":true},{"id":"hl-roosenberg-abbey","name":"Roosenberg Abbey","kind":"Monastery","lat":51.11906,"lon":4.07819,"dist_km":18.0,"rank_score":5.69,"resolved_by":"catalogue","image":{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/d/d6/Roosenberg_Abbey%2C_Waasmunster%2C_2025.jpg/960px-Roosenberg_Abbey%2C_Waasmunster%2C_2025.jpg","author":"DimiTalen","licence":"CC0","licence_url":"http://creativecommons.org/publicdomain/zero/1.0/deed.en","page":"https://commons.wikimedia.org/wiki/File:Roosenberg_Abbey,_Waasmunster,_2025.jpg","w":6016,"h":4000,"ok_print":true}},{"id":"hl-sint-willibrordusbasiliek","name":"Sint-Willibrordusbasiliek","kind":"Church","lat":51.28062,"lon":4.05403,"dist_km":0.1,"sig":2.502,"rank_score":5.5,"resolved_by":"cat