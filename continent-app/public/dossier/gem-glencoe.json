339,"dist_km":5.9,"rank_score":3.6,"resolved_by":"retyped"},{"id":"hl-kingshouse-etive-bridge","name":"Kingshouse, Etive Bridge","kind":"Bridge","lat":56.6516,"lon":-4.85232,"dist_km":8.4,"rank_score":2.8,"resolved_by":"catalogue","heritage":true},{"id":"hl-massacre-of-glencoe-monument","name":"Massacre of Glencoe Monument","kind":"Monument","lat":56.68235,"lon":-5.09509,"dist_km":6.8,"rank_score":2.7,"resolved_by":"retyped","image":{"url":"https://upload.wikimedia.org/wikipedia/commons/thumb/3/3c/Glencoe_Massacre_Memorial_2.JPG/500px-Glencoe_Massacre_Memorial_2.JPG","author":"Kim Traynor","licence":"CC BY-SA 3.0","licence_url":"https://creativecommons.org/licenses/by-sa/3.0","page":"https://commons.wikimedia.org/wiki/File:Glencoe_Massacre_Memorial_2.JPG","ok_print":true},"wikipedia":"https://en.wikipedia.org/wiki/Massacre_of_Glencoe_Monument"}],"do":[{"name":"Hillwalk the Glen Coe ridges","type":"trail","detail":"Bidean nam Bian, Buachaille Etive Mor and the knife edge Aonach Eagach rise straight off the glen road.","season":[5,6,7,8,9,10],"evidence":{"n_sources":8,"of":12,"urls":["https://www.visitscotland.com/places-to-go/glencoe","https://en.wikipedia.org/wiki/Glen_Coe","https://www.undiscoveredscotland.co.uk/glencoe/glencoe/index.html","https://www.glencoemountain.co.uk/"],"method":"web"},"sources":["web"]},{"name":"The 1692 massacre, told on site","type":"experience","detail":"The visitor centre and the walk to Signal Rock set out what happened to the MacDonalds that February.","evidence":{"n_sources":6,"of":12,"urls":["https://www.undiscoveredscotland.co.uk/glencoe/glencoe/index.html","https://en.wikipedia.org/wiki/Glen_Coe","https://www.discoverglencoe.scot/"],"method":"web"},"sources":["web"]},{"name":"The Lost Valley","type":"trail","detail":"Coire Gabhail, where the MacDonalds hid stolen cattle. Up a dried riverbed with a little scrambling, about an hour and a quarter, and the valley floor opens out flat and hidden at the top.","evidence":{"n_sources":6,"of":12,"urls":["https://www.familycantravel.com/lost-valley-walk-glencoe-scotland/","https://thetwirlingtraveler.nl/most-beautiful-hike-in-scotland/","https://anywhereweroam.com/glencoe-scotland/"],"method":"web"},"sources":["web"]},{"name":"The Three Sisters","type":"activity","detail":"Beinn Fhada, Gearr Aonach and Aonach Dubh drop their buttresses straight onto the A82, and the roadside viewpoint looks up all three at once.","evidence":{"n_sources":6,"of":12,"urls":["https://www.wandersomewhere.com/travel/guide-hiking-three-sisters-glencoe","https://www.wayfaringkiwi.com/things-to-do-in-glencoe-scotland/","https://www.roamingintheknow.com/scotland/things-to-do-glencoe"],"method":"web"},"sources":["web"]},{"name":"Ski and board at Glencoe Mountain","type":"activity","detail":"Scotland's oldest ski ground sits on Meall a Bhuiridh, with lessons, hire and sledging when snow holds.","season":[12,1,2,3,4],"link":"https://www.glencoemountain.co.uk/","evidence":{"n_sources":5,"of":12,"urls":["https://www.glencoemountain.co.uk/","https://en.wikipedia.org/wiki/Glen_Coe","https://www.undiscoveredscotland.co.uk/glencoe/glencoe/index.html","https://www.visitscotland.com/places-to-go/glencoe"],"method":"web"},"sources":["web"]},{"name":"A night at the Clachaig Inn","type":"experience","detail":"The climbers' bar in the glen, with local ales, boots by the fire and live music on many weekends.","evidence":{"n_sources":5,"of":12,"urls":["https://en.wikipedia.org/wiki/Glen_Coe","https://www.undiscoveredscotland.co.uk/glencoe/glencoe/index.html","https://www.visitscotland.com/places-to-go/glencoe","https://www.discoverglencoe.scot/"],"method":"web"},"sources":["web"]},{"name":"Find the film locations","type":"experience","detail":"The glen and Glen Etive stood in for Bond country and for Hogwarts hillsides, and guides run the circuit.","evidence":{"n_sources":5,"of":12,"urls":["https://www.visitscotland.com/places-to-go/glencoe","https://en.wikipedia.org/wiki/Glen_Coe","https://www.discoverglencoe.scot/"],"method":"web"},"sources":["web"]},{"name":"Chairlift up and bike down","type":"activity","detail":"The lift carries riders and walkers to the plateau cafe, with downhill trails and hire bikes at the base.","season":[5,6,7,8,9],"link":"https://www.glencoemountain.co.uk/summer","evidence":{"n_sources":4,"of":12,"urls":["https://www.glencoemountain.co.uk/summer","https://www.visitscotland.com/places-to-go/glencoe","https://www.discoverglencoe.scot/"],"method":"web"},"sources":["web"]},{"name":"Devil's Staircase on the West Highland Way","type":"trail","detail":"The long walk crosses the head of the glen and zigzags over the pass down to Kinlochleven.","season":[5,6,7,8,9],"evidence":{"n_sources":4,"of":12,"urls":["https://en.wikipedia.org/wiki/Glen_Coe","https://www.undiscoveredscotland.co.uk/glencoe/glencoe/index.html","https://www.visitscotland.com/places-to-go/glencoe"],"method":"web"},"sources":["web"]},{"name":"National Trust visitor centre","type":"activity","detail":"Off the A82 at the east end of the glen: the geology, the wildlife and the massacre in one exhibition, plus trail maps for the walks and a cafe.","evidence":{"n_sources":4,"of":12,"urls":["https://lovetovisitscotland.com/best-things-to-do-in-glencoe-scotland/","https://www.roamingintheknow.com/scotland/things-to-do-glencoe","https://anywhereweroam.com/glencoe-scotland/"],"method":"web"},"sources":["web"]}],"nearby":{"lakes":[{"layer":"lakes","cc":"GB","id":"gb-loch-shiel-Q1867298","name":"Loch Shiel","km":39.1,"bearing":"W","lat":56.79111,"lon":-5.58704,"tier":0,"score":5.6,"thumb":"https://upload.wikimedia.org/wikipedia/commons/1/14/Loch_Shiel.jpg","thumb_ok_print":true}],"trails":[{"layer":"trails","cc":"GB","id":"188593","name":"Bideam nam Bian Trail","km":2.0,"bearing":"SW","lat":56.65305,"lon":-5.00547,"tier":2,"thumb":"https://upload.wikimedia.org/wikipedia/commons/thumb/3/37/The_ridge_linking_Stob_Coire_nan_Lochan_to_Bidean_nam_Bian_-_geograph.org.uk_-_6487548.jpg/12