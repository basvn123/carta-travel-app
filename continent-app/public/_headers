# Cloudflare Pages header rules: the only place the app's response headers
# (security headers, CSP, cache policy) are set. Cloudflare Pages serves the
# app on the same edge as R2 and the images.
#
# Two things about the syntax matter:
#
# 1. Pages matches a path with a trailing :splat wildcard, not a regex, so
#    "/poi/*". There is no alternation, which is why the six root JSON files
#    and the ten layer directories each get one stanza per path below.
#
# 2. Pages applies EVERY matching rule cumulatively, and where two matching
#    rules set the SAME header name the two values are joined with a comma
#    rather than the more specific one winning. That is a live trap, and
#    the layout below is built to avoid it rather than to rely on it: the "/*"
#    stanza sets only the six security headers and deliberately sets NO
#    Cache-Control, so it can never collide with the per-path Cache-Control
#    rules above. If you ever add a Cache-Control to "/*", every path in this
#    file starts emitting two comma-joined caching policies and the result is
#    whatever the CDN makes of it. Put a default in each path instead.
#
#    Current usage against the Pages limits: 29 rules of 100, longest line
#    1,025 characters of 2,000 (the CSP, counted at T557). Both have room,
#    but the CSP is the one to watch as hosts are added in P3.
#
# Deliberately NOT here: a catch-all SPA rewrite. The app is a single
# client-rendered URL and keeps all of its routing in the hash and the query
# string, so nothing needs one, and adding one would make a missing data shard
# answer 200 with HTML instead of 404 with nothing. That failure mode has
# already cost this project a debugging session once. Keep it impossible.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The boot index the map starts from (T054; it replaced /app_data.json).
/boot.json
  Cache-Control: public, max-age=600, stale-while-revalidate=86400

/poi/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# One destination file per country, requested as /dest/<cc>.json?v=<hash>.
/dest/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Bed prices per country (T534): the copy that ships, and the monthly
# refresh the Actions workflow writes under stays-live.
/stays/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/stays-live/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# The six root JSON documents the map boots from, one stanza each.
/search_index.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# The guided search data (T439), a folder on the data host (T445).
/search/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/coverage.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/country_insights.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/country_shapes.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/poi_credits.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/joins.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Per-origin fare slices and reachability, refreshed on the pipeline's cadence.
/fares/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/reach/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# The ten layer directories. Content changes on a weekly pipeline run at most,
# so these carry a week of stale-while-revalidate. One stanza each.
/dossier/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/destinfo/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/region/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/beaches/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/lakes/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/mountains/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/trails/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/cycling/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/trips/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/journeys/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

# The service worker must never be served stale, or a client can pin itself to
# an old build indefinitely.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/sitemap.xml
  Cache-Control: public, max-age=3600

# Security headers, site-wide.
#
# The CSP amendments are scheduled as follows:
#
#   - cdn.carta-europetravel.com added to img-src (T053, done).
#   - https://tiles.mapterhorn.com added to connect-src and img-src (T430,
#     the code half of T233-e): the 2D / 3D control under an item-page map
#     reads Mapterhorn's elevation tiles until the R2 mirror exists.
#   - https://data.carta-europetravel.com added to connect-src (T290, closing
#     T053-b) once the domain resolved and the data was on it. T054 built the
#     split; its scripts/r2/stage-data.mjs refuses a build that points the app
#     at the data host while this line lacks it.
#   - https://data.carta-europetravel.com added to img-src (T516): the
#     airline logos the flight sweep copies to R2 data/airlines/{code}.png.
#   - 'wasm-unsafe-eval' added to script-src (T557): Ask Carta's on-device
#     model (WebLLM in a worker) compiles its WebAssembly with
#     WebAssembly.instantiate, which a CSP without it refuses. It allows
#     WebAssembly compilation only, not eval() or new Function(). The model
#     files come from data.carta-europetravel.com/ask/model/, already in
#     connect-src; worker-src 'self' blob: was already enough.
#
#   - T1120 (H2): the error tracker's ingest host is NOT listed yet, on purpose: it
#     is the exact host in the owner's DSN (o<id>.ingest.de.sentry.io, no wildcard),
#     added to connect-src with the DSN (register row T1120-a). Until then the
#     reporter is a no-op and the CSP would refuse it anyway.
#   - wss://*.supabase.co removed from connect-src (T1079, C5): no code opens a
#     Supabase realtime channel (grep for .channel( and realtime in src/ is
#     empty), so the socket host allowed nothing. Add it back with the first
#     feature that subscribes.
#   - Permissions-Policy lists every powerful feature the app never uses, and
#     Cross-Origin-Opener-Policy is same-origin-allow-popups (T1079, C5): the
#     print view opens a popup from window.open (tripExport.js), which plain
#     same-origin would sever. Every host still in the CSP is called by code:
#     checked one by one in the T1079 report.
#   - style-src 'unsafe-inline' removed (T1090, C5). The app styles itself from
#     the bundled sheets ('self') and through the CSSOM (React style props,
#     MapLibre, element.style), which no style-src governs. The two <style>
#     blocks it writes are allowed by hash and nothing else: the print view's
#     popup (PRINT_CSS, src/lib/tripExport.js) and a prerendered page's reading
#     column (STYLE, scripts/prerender/html.mjs). Change either and run
#     `node scripts/csp-hashes.mjs --write`; npm test fails until you do, and
#     scripts/verify_csp.mjs (CI job csp) fails on any refusal on any screen.
#
# The data-host stanzas above (poi, dest, fares, reach, the layer directories
# and the three catalogue-sized root files) are also read by
# scripts/r2/cachePolicy.mjs, which uploads each R2 object with the same
# Cache-Control. Change the policy here and both hosts follow.
#   - Only THEN remove upload.wikimedia.org, thumb.wikimedia.org,
#     commons.wikimedia.org and the four geograph.org.uk hosts from img-src,
#     once the image ladder is live and nothing still hotlinks them directly
#     (tracked in Execution/_OPEN.md row T052-f).
#
# Removing the Wikimedia and Geograph hosts before the ladder ships would blank
# every photograph in the app. The order is: add, migrate, verify, then remove.
# Pages adds Access-Control-Allow-Origin: * to every static answer by default
# (ZAP 10098, T1164). Nothing reads this host's files from another origin: the
# app fetches them same-origin, and the data shards are on R2 with their own
# CORS. So the default is detached here (T1164-d, T1211, ASVS V3.4.2).
/*
  ! Access-Control-Allow-Origin
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'sha256-czAy1a8jl0ZlfqmX1r8uBBiDzGCYhp5dpQoYABQFhAo=' 'sha256-MDz8ez0nW4buys6c4AOOf4l0q+L51Ez9KZj2RNEAIps='; font-src 'self' data:; img-src 'self' data: blob: https://*.cartocdn.com https://cdn.carta-europetravel.com https://data.carta-europetravel.com https://upload.wikimedia.org https://thumb.wikimedia.org https://commons.wikimedia.org https://s0.geograph.org.uk https://s1.geograph.org.uk https://s2.geograph.org.uk https://s3.geograph.org.uk https://tile.openstreetmap.org https://tiles.mapterhorn.com https://flagcdn.com; frame-src https://www.foto-webcam.eu; connect-src 'self' https://data.carta-europetravel.com https://*.supabase.co https://*.cartocdn.com https://routing.openstreetmap.de https://nominatim.openstreetmap.org https://overpass-api.de https://overpass.kumi.systems https://*.wikipedia.org https://tiles.mapterhorn.com; manifest-src 'self'; upgrade-insecure-requests
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(), usb=(), bluetooth=(), serial=(), hid=(), accelerometer=(), gyroscope=(), magnetometer=(), display-capture=(), browsing-topics=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
