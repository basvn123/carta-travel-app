# Copy to .env on the box (never commit .env). Fill every change-me.
# Generate secrets with: openssl rand -hex 32   (ENCRYPTION_KEY must be exactly 64 hex characters)
POSTGRES_PASSWORD=change-me
CLICKHOUSE_PASSWORD=change-me
MINIO_ROOT_PASSWORD=change-me
REDIS_AUTH=change-me
SALT=change-me
ENCRYPTION_KEY=change-me-64-hex-characters
NEXTAUTH_SECRET=change-me
NEXTAUTH_URL=http://localhost:3000
LANGFUSE_INIT_USER_EMAIL=change-me
LANGFUSE_INIT_USER_PASSWORD=change-me
# Project keys: pick them here; the same two values go to the eval runner and,
# later, to the Edge Function secrets (E4). Public keys start pk-lf-, secret keys sk-lf-.
LANGFUSE_PUBLIC_KEY=pk-lf-change-me
LANGFUSE_SECRET_KEY=sk-lf-change-me
# The clients read the server address under different names by SDK version:
# set both on the machine that sends (the runner, the Edge Functions).
LANGFUSE_BASE_URL=http://127.0.0.1:3000
LANGFUSE_BASEURL=http://127.0.0.1:3000
