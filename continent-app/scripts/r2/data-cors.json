{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://www.carta-europetravel.com",
          "https://carta-europetravel.com",
          "https://carta-app.pages.dev",
          "https://preview.carta-app.pages.dev",
          "https://design.carta-app.pages.dev",
          "http://localhost:5173",
          "http://localhost:4173"
        ],
        "methods": [
          "GET",
          "HEAD"
        ],
        "headers": [
          "Range",
          "If-Match",
          "If-None-Match"
        ]
      },
      "maxAgeSeconds": 86400,
      "exposeHeaders": [
        "ETag",
        "Content-Range",
        "Content-Length",
        "Accept-Ranges"
      ]
    }
  ]
}
