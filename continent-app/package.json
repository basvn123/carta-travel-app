{
  "name": "europe-travel-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "data": "node scripts/sync-data.mjs",
    "predev": "node scripts/sync-data.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-data.mjs",
    "build": "vite build",
    "postbuild": "node scripts/r2/stage-data.mjs",
    "data:push": "node scripts/r2/push-data.mjs",
    "data:verify": "node scripts/r2/verify-data.mjs",
    "preview": "vite preview",
    "smoke": "node scripts/smoke-nav.mjs",
    "shoot:planners": "node scripts/shoot-planners.mjs",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{js,jsx}\"",
    "test": "node --test --test-concurrency=1 \"tests/*.test.mjs\"",
    "test:browser": "node --test --test-concurrency=1 \"tests/*.spec.mjs\"",
    "verify": "node scripts/verify-affiliate.mjs && node scripts/verify-omio.mjs && node scripts/verify_paywall.mjs",
    "test:quota": "node scripts/verify_plan_tiers.mjs && node scripts/ai/test_global_cap.mjs && node scripts/ai/test_ai_quota.mjs && node scripts/ai/test_passes.mjs",
    "check:pages": "node scripts/check-pages-limits.mjs dist",
    "ci:routes": "node scripts/ci/check-routes.mjs",
    "ci:contract": "node scripts/ci/check-contract.mjs",
    "ci:smoke": "node scripts/ci/smoke.mjs",
    "ci": "npm run lint && npm run test && npm run verify && npm run ci:routes && npm run ci:contract && npm run build && npm run ci:smoke"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.2",
    "jspdf": "^3.0.4",
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "playwright": "^1.61.1",
    "prettier": "^3.9.5",
    "vite": "^8.1.4"
  }
}
