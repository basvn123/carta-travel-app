          "description": "not yet described"
        },
        "climate_model": {
          "type": "object",
          "x-presence": "required",
          "description": "not yet described"
        },
        "climate_period": {
          "type": "string",
          "x-presence": "required",
          "description": "not yet described"
        },
        "country_context_model": {
          "type": "object",
          "x-presence": "required",
          "description": "not yet described"
        },
        "designation_model": {
          "type": "object",
          "x-presence": "required",
          "description": "not yet described"
        },
        "image_model": {
          "type": "object",
          "x-presence": "required",
          "description": "not yet described"
        },
