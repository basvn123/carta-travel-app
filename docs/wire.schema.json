{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carta.travel/schema/wire.schema.json",
  "title": "Carta wire contract: continent-app/public/app_data.json",
  "description": "The one machine-readable data contract (T1133, ROADMAP D1). Read by the pipeline writers (pipeline/wire_contract.py, called from pipeline_io.atomic_write_json before every write of the wire), by the app sync (continent-app/scripts/sync-data.mjs) and by the CI contract gate (continent-app/scripts/ci/contract.mjs, check-contract.mjs). The table \"Wire contract\" in docs/SCHEMA.md is generated from this file (node continent-app/scripts/ci/wire-table.mjs --write). Keywords used: a JSON Schema 2020-12 subset (type, enum, const, pattern, minLength, minimum, maximum, items, prefixItems, minItems, maxItems, properties, required, additionalProperties, minProperties, $ref) plus x-presence (required, every, some), which is checked only on a full catalogue.",
  "x-schema-version": 20,
  "type": "object",
  "required": [
    "meta",
    "destinations"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "schema_version",
        "currency",
        "start_date",
        "end_date",
        "defaults",
        "baggage_options"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 20,
          "x-presence": "required",
          "description": "header line; read on boot"
        },
        "currency": {
          "type": "string",
          "const": "EUR",
          "x-presence": "required",
          "description": "app_data.json block; read on boot"
        },
        "start_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "x-presence": "required",
          "description": "app_data.json block; read on boot"
        },
        "end_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "x-presence": "required",
          "description": "app_data.json block; read on boot"
        },
        "defaults": {
          "type": "object",
          "x-presence": "required",
          "description": "app_data.json block; read on boot"
        },
        "baggage_options": {
          "type": "object",
          "x-presence": "required",
          "description": "app_data.json block; read on boot"
        },
        "generated_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T",
          "x-presence": "required",
          "description": "app_data.json block"
        },
        "origins": {
          "type": "object",
          "x-presence": "required",
          "description": "app_data.json block"
        },
        "home_city": {
          "type": "string",
          "x-presence": "required",
          "description": "app_data.json block"
        },
        "home": {
          "type": "object",
          "x-presence": "required",
          "description": "app_data.json block"
        },
        "categories": {
          "type": "array",
          "x-presence": "required",
          "description": "app_data.json block"
        },
        "cost_basket": {
          "type": "object",
          "x-presence": "required",
          "description": "app_data.json block"
        },
        "cost_validation": {
          "type": "object",
          "x-presence": "required",
          "description": "app_data.json block"
        },
        "stays": {
          "type": "object",
          "x-presence": "required",
          "description": "app_data.json block"
        },
        "food_model": {
          "type": "object",
          "x-presence": "required",
          "description": "food and drink model v2 (T513): method and validation"
        },
        "food_country": {
          "type": "object",
          "x-presence": "required",
          "description": "food and drink model v2 (T513): the country bases"
        },
        "car_model": {
          "type": "object",
          "x-presence": "required",
          "description": "app_data.json block; Schema v14 section 2"
        },
        "n_destinations": {
          "type": "integer",
          "minimum": 0,
          "x-presence": "required",
          "description": "app_data.json block"
        },
        "is_mock": {
          "type": "boolean",
          "x-presence": "required",
          "description": "app_data.json block"
        },
        "beauty_model": {
          "type": "object",
          "x-presence": "required",
          "description": "app_data.json block (`beauty.gems`)"
        },
        "flight_model": {
          "type": "object",
          "x-presence": "required",
          "description": "app_data.json block (`fare_model`)"
