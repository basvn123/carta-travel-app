        "tier": {
          "type": "string",
          "enum": [
            "airport",
            "gem"
          ],
          "x-presence": "every",
          "description": "app_data.json block"
        },
        "iata": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z0-9]{3}$",
          "x-presence": "every",
          "description": "app_data.json block"
        },
        "city": {
          "type": "string",
          "minLength": 1,
          "x-presence": "every",
          "description": "app_data.json block"
        },
        "country": {
          "type": "string",
          "minLength": 1,
          "x-presence": "every",
          "description": "app_data.json block"
        },
        "iso2": {
          "type": "string",
          "pattern": "^[A-Z]{2}$",
          "x-presence": "every",
          "description": "app_data.json block"
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90,
          "x-presence": "every",
          "description": "app_data.json block"
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180,
          "x-presence": "every",
          "description": "app_data.json block"
        },
        "categories": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "x-presence": "every",
          "description": "app_data.json block"
        },
        "tags": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "x-presence": "every",
          "description": "app_data.json block"
        },
        "blurb": {
          "type": [
            "string",
            "null"
          ],
          "x-presence": "every",
          "description": "app_data.json block"
        },
        "no_ryanair_route": {
