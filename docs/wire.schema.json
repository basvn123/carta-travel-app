          "description": "Schema v14 section 1"
        },
        "tourist_premium_model": {
          "type": "object",
          "x-presence": "required",
          "description": "Schema v14 section 3"
        }
      }
    },
    "destinations": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {
        "$ref": "#/$defs/destination"
      }
    }
  },
  "$defs": {
    "destination": {
      "type": "object",
      "required": [
        "id",
        "tier",
        "city",
        "country",
        "iso2",
        "lat",
        "lon"
